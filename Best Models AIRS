{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.12","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":87331,"databundleVersionId":10191418,"sourceType":"competition"}],"dockerImageVersionId":31240,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# ==========================================================\n# 🚀 CATBOOST TRAINING & EVALUATION (80/20 – NO VALIDATION)\n# ==========================================================\n\n# Import necessary libraries for the entire project\nimport os  # For working with files and directories\nimport numpy as np  # For numerical operations and arrays\nimport pandas as pd  # For data manipulation and analysis (like Excel in Python)\nimport librosa  # For audio processing and feature extraction\nimport scipy  # For scientific computing and signal processing\nimport pickle  # For saving and loading Python objects to/from files\nfrom tqdm import tqdm  # For showing progress bars during long operations\nimport warnings  # For controlling warning messages\nwarnings.filterwarnings(\"ignore\")  # Hide warning messages to keep output clean\n\n# Import machine learning specific libraries\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler  # For encoding categories and scaling features\nfrom sklearn.impute import SimpleImputer  # For handling missing values in data\nfrom sklearn.model_selection import train_test_split  # For splitting data into training and testing sets\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix  # For evaluating model performance\nfrom catboost import CatBoostClassifier  # The main machine learning model we'll use\nimport seaborn as sns  # For creating statistical graphics and heatmaps\nimport matplotlib.pyplot as plt  # For creating plots and visualizations\n\n# =======================\n# PATHS & PARAMETERS\n# =======================\n# Define file paths and important settings that will be used throughout the code\nSOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"  # Folder containing audio files\nTRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"  # Path to training data CSV file\nTEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"  # Path to test data CSV file\nCACHE_FILE = \"/kaggle/working/audio_cache.pkl\"  # File to save/load extracted audio features (saves time)\n\n# Audio processing parameters\nSR = 16000  # Target sample rate (samples per second) for audio files\nDURATION = 2  # Target audio duration in seconds\nTARGET_LEN = SR * DURATION  # Total number of samples for 2 seconds of audio\nN_MFCC = 30  # Number of MFCC (audio feature) coefficients to extract\n\n# =======================\n# LOAD DATA\n# =======================\nprint(\"📂 Loading data...\")  # Show progress message\n# Read CSV files into pandas DataFrames (tables)\ndf_train = pd.read_csv(TRAIN_PATH)  # Load training data\ndf_test  = pd.read_csv(TEST_PATH)   # Load test data\n\nprint(f\"✅ Train data shape: {df_train.shape}\")  # Show dimensions (rows, columns) of training data\nprint(f\"✅ Test data shape: {df_test.shape}\")   # Show dimensions of test data\n\n# Handle missing values in training data\nfor col in df_train.columns:  # Loop through each column in training data\n    if df_train[col].isnull().sum() > 0:  # Check if column has missing values\n        # Fill missing values with the most frequent value (mode) in that column\n        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n\n# Handle missing values in test data (same process as above)\nfor col in df_test.columns:\n    if df_test[col].isnull().sum() > 0:\n        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n\n# =======================\n# AUDIO FEATURE EXTRACTION\n# =======================\n\ndef resample(y, orig_sr, target_sr=16000):\n    \"\"\"Resample audio to a target sample rate if needed\"\"\"\n    if orig_sr != target_sr:  # Only resample if current rate differs from target\n        # Calculate new length and resample\n        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n    return y  # Return resampled audio\n\ndef pad_truncate(y, length):\n    \"\"\"Make audio exactly the target length by padding or truncating\"\"\"\n    # Add zeros if audio is too short, or cut if too long\n    return np.pad(y, (0, max(0, length - len(y))))[:length]\n\ndef extract_audio(path):\n    \"\"\"Extract various audio features from a single audio file\"\"\"\n    try:\n        # Load audio file with its original sample rate\n        y, sr = librosa.load(path, sr=None)\n        \n        # Check if audio loaded successfully\n        if y is None or len(y) == 0:  # If file is empty or failed to load\n            # Print warning and return dummy (zero) features\n            print(f\"⚠️  WARNING: Empty audio file or failed to load: {os.path.basename(path)} - Using dummy features\")\n            # Return array of zeros with correct length and False flag for failure\n            return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False\n        \n        # Process the audio\n        y = resample(y, sr, SR)  # Resample to target rate\n        y = pad_truncate(y, TARGET_LEN)  # Make exactly 2 seconds long\n\n        # Extract various audio features:\n        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)  # MFCC: captures timbre\n        delta = librosa.feature.delta(mfcc)  # First derivative of MFCC (change over time)\n        delta2 = librosa.feature.delta(mfcc, order=2)  # Second derivative (acceleration)\n        chroma = librosa.feature.chroma_stft(y=y, sr=SR)  # Musical pitch information\n        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)  # Spectral shape\n        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)  # Tonal content\n        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)  # Mel spectrum\n        tempogram = librosa.feature.tempogram(y=y, sr=SR)  # Rhythm/tempo information\n\n        # Combine all features into one array by taking mean and standard deviation\n        feats = np.concatenate([\n            mfcc.mean(1), mfcc.std(1),  # Mean and std of MFCC\n            delta.mean(1), delta.std(1),  # Mean and std of delta\n            delta2.mean(1), delta2.std(1),  # Mean and std of delta2\n            chroma.mean(1), chroma.std(1),  # Mean and std of chroma\n            contrast.mean(1), contrast.std(1),  # Mean and std of contrast\n            tonnetz.mean(1),  # Only mean of tonnetz\n            mel.mean(1), mel.std(1),  # Mean and std of mel spectrum\n            [np.mean(tempogram)]  # Mean of tempogram\n        ])\n        return feats, True  # Return features and success flag\n    except Exception as e:  # Catch any error during processing\n        # Print error and return dummy features\n        print(f\"❌ ERROR: Failed to process {os.path.basename(path)} - Error: {str(e)[:50]}... - Using dummy features\")\n        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False\n\ndef build_audio(df, cache=None):\n    \"\"\"Extract audio features for all files in DataFrame, with optional caching\"\"\"\n    # Check if cache exists and is valid\n    if cache and os.path.exists(cache):  # If cache file exists\n        try:\n            print(\"📂 Loading audio features from cache...\")\n            with open(cache, \"rb\") as f:  # Open cache file in binary read mode\n                audio_df = pickle.load(f)  # Load cached data\n            print(f\"✅ Loaded {len(audio_df)} cached audio feature rows\")\n            \n            # Check if cache has the new format with success tracking\n            if 'feature_extraction_success' not in audio_df.columns:\n                print(\"⚠️  Cache is in old format (no extraction tracking)\")\n                # Add dummy column for compatibility\n                audio_df['feature_extraction_success'] = True\n            return audio_df  # Return cached data\n        except Exception as e:  # If cache loading fails\n            print(f\"❌ Error loading cache: {e}. Re-extracting features...\")\n    \n    # If no cache exists or cache loading failed, extract features from scratch\n    print(\"🎵 Starting audio feature extraction from scratch...\")\n    feats = []  # List to store features\n    success_count = 0  # Counter for successful extractions\n    total_count = len(df[\"candidateID\"])  # Total number of audio files\n    \n    # Loop through all candidate IDs with progress bar\n    for cid in tqdm(df[\"candidateID\"], desc=\"Extracting audio features\"):\n        # Construct full path to audio file\n        path = os.path.join(SOUND_DIR, f\"{cid}.wav\")\n        \n        # Check if file exists\n        if not os.path.exists(path):  # If file doesn't exist\n            print(f\"❌ FILE NOT FOUND: {cid}.wav - Using dummy features\")\n            feats.append((np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False))\n            continue  # Skip to next file\n            \n        # Extract features from audio file\n        feat, success = extract_audio(path)\n        feats.append((feat, success))  # Store features and success flag\n        if success:\n            success_count += 1  # Increment success counter\n    \n    # Separate features and success flags into two lists\n    feat_arrays = [f[0] for f in feats]  # List of feature arrays\n    success_flags = [f[1] for f in feats]  # List of success/failure flags\n    \n    # Create descriptive column names for all features\n    cols = (\n        [f\"mfcc_mean_{i}\" for i in range(30)] +  # 30 MFCC mean columns\n        [f\"mfcc_std_{i}\" for i in range(30)] +   # 30 MFCC std columns\n        [f\"delta_mean_{i}\" for i in range(30)] + # 30 delta mean columns\n        [f\"delta_std_{i}\" for i in range(30)] +  # 30 delta std columns\n        [f\"delta2_mean_{i}\" for i in range(30)] + # 30 delta2 mean columns\n        [f\"delta2_std_{i}\" for i in range(30)] + # 30 delta2 std columns\n        [f\"chroma_mean_{i}\" for i in range(12)] + # 12 chroma mean columns\n        [f\"chroma_std_{i}\" for i in range(12)] +  # 12 chroma std columns\n        [f\"contrast_mean_{i}\" for i in range(7)] + # 7 contrast mean columns\n        [f\"contrast_std_{i}\" for i in range(7)] +  # 7 contrast std columns\n        [f\"tonnetz_{i}\" for i in range(6)] +      # 6 tonnetz columns\n        [f\"mel_mean_{i}\" for i in range(128)] +   # 128 mel mean columns\n        [f\"mel_std_{i}\" for i in range(128)] +    # 128 mel std columns\n        [\"tempogram_mean\"]  # 1 tempogram column\n    )\n    \n    # Create DataFrame from feature arrays\n    audio_df = pd.DataFrame(feat_arrays, columns=cols)\n    # Add candidate IDs and success flags to DataFrame\n    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n    audio_df[\"feature_extraction_success\"] = success_flags\n    \n    # Print extraction summary\n    print(\"\\n\" + \"=\"*60)\n    print(\"📊 AUDIO FEATURE EXTRACTION SUMMARY\")\n    print(\"=\"*60)\n    print(f\"✅ Original features extracted: {success_count}/{total_count} ({success_count/total_count*100:.1f}%)\")\n    print(f\"⚠️  Dummy features used: {total_count - success_count}/{total_count} ({(total_count-success_count)/total_count*100:.1f}%)\")\n    \n    # Show which files failed (first 10 only)\n    if success_count < total_count:\n        failed_ids = df[\"candidateID\"][[not flag for flag in success_flags]].tolist()\n        print(f\"❌ Files with issues (first 10): {failed_ids[:10]}{'...' if len(failed_ids) > 10 else ''}\")\n    \n    # Save features to cache file if cache path provided\n    if cache:\n        print(f\"💾 Caching features to {cache}...\")\n        with open(cache, \"wb\") as f:  # Open cache file in binary write mode\n            pickle.dump(audio_df, f)  # Save DataFrame to file\n        print(\"✅ Features cached successfully\")\n\n    return audio_df  # Return the complete audio features DataFrame\n\nprint(\"\\n🎵 Extracting audio features...\")\n# Build audio features for training data, using cache if available\ntrain_audio = build_audio(df_train, CACHE_FILE)\n\n# =======================\n# LABEL ENCODING\n# =======================\nprint(\"\\n🔤 Encoding categorical variables...\")\n# List of categorical columns that need to be converted to numbers\ncategorical_cols = [\n    'gender','tbContactHistory','wheezingHistory',\n    'phlegmCough','familyAsthmaHistory',\n    'feverHistory','coldPresent'\n]\n\n# Create a copy of training data for encoding\ndf_train_enc = df_train.copy()\n\n# Convert each categorical column to numerical codes\nfor col in categorical_cols:\n    le = LabelEncoder()  # Create label encoder\n    # Convert to string then to numerical codes\n    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n\nprint(\"✅ Categorical encoding completed\")\n\n# =======================\n# MERGE FEATURES\n# =======================\nprint(\"\\n\" + \"=\"*60)\nprint(\"🔗 MERGING FEATURES\")\nprint(\"=\"*60)\nprint(f\"📊 Tabular data shape: {df_train_enc.drop(['candidateID','disease'], axis=1).shape}\")\n\n# Handle audio features - check if we have the new column\nif 'feature_extraction_success' in train_audio.columns:\n    print(\"✅ Using audio features with extraction success tracking\")\n    audio_columns_to_drop = ['candidateID', 'feature_extraction_success']\n    \n    # Calculate and print success rate\n    success_rate = train_audio['feature_extraction_success'].mean() * 100\n    print(f\"📊 Audio feature extraction success rate: {success_rate:.1f}%\")\n    print(f\"   - Successful: {train_audio['feature_extraction_success'].sum()}/{len(train_audio)}\")\n    print(f\"   - Failed: {len(train_audio) - train_audio['feature_extraction_success'].sum()}/{len(train_audio)}\")\nelse:\n    print(\"⚠️  Using cached audio features (no extraction success tracking)\")\n    audio_columns_to_drop = ['candidateID']\n    print(\"ℹ️  Feature extraction statistics not available in cached data\")\n\nprint(f\"🎵 Audio data shape: {train_audio.drop(audio_columns_to_drop, axis=1).shape}\")\n\n# Combine tabular data and audio features into one feature matrix\nX = pd.concat([\n    # Tabular features (excluding ID and target)\n    df_train_enc.drop(['candidateID','disease'], axis=1),\n    # Audio features (excluding ID and success tracking)\n    train_audio.drop(audio_columns_to_drop, axis=1)\n], axis=1)  # axis=1 means combine columns (side by side)\n\n# Encode target variable (disease labels) to numbers\ny = LabelEncoder().fit_transform(df_train['disease'])\n\nprint(f\"✅ Final feature matrix shape: {X.shape}\")\n\n# =======================\n# IMPUTE & SCALE\n# =======================\nprint(\"\\n⚙️  Preprocessing features...\")\n# Handle any remaining missing values\nimputer = SimpleImputer(strategy=\"most_frequent\")  # Replace missing with most common value\nX = imputer.fit_transform(X)  # Apply to feature matrix\n\n# Scale features to have mean=0 and variance=1 (helps model training)\nscaler = StandardScaler()\nX = scaler.fit_transform(X)\n\nprint(\"✅ Imputation and scaling completed\")\n\n# =======================\n# 80 / 20 TRAIN–TEST SPLIT\n# =======================\n# Split data into training (80%) and testing (20%) sets\nX_train, X_test, y_train, y_test = train_test_split(\n    X,  # Feature matrix\n    y,  # Target labels\n    test_size=0.20,  # 20% for testing\n    stratify=y,  # Keep same class proportions in both sets\n    random_state=42  # For reproducibility (same split every time)\n)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"📊 DATA SPLIT SUMMARY\")\nprint(\"=\"*60)\nprint(f\"✅ Train Samples: {X_train.shape[0]} ({X_train.shape[0]/len(X)*100:.1f}%)\")\nprint(f\"✅ Test Samples : {X_test.shape[0]} ({X_test.shape[0]/len(X)*100:.1f}%)\")\nprint(f\"✅ Number of features: {X_train.shape[1]}\")\n\n# =======================\n# CLASS WEIGHTS\n# =======================\nfrom collections import Counter\n# Count samples in each class\ncounter = Counter(y_train)\ntotal = sum(counter.values())\n# Calculate class weights to handle imbalanced data (give more weight to rare classes)\nclass_weights = {k: total/(len(counter)*v) for k,v in counter.items()}\n\nprint(\"\\n📊 Class Distribution:\")\nfor class_id, count in sorted(counter.items()):\n    print(f\"  Class {class_id}: {count} samples ({count/total*100:.1f}%)\")\nprint(\"📊 Class Weights:\", class_weights)\n\n# =======================\n# CATBOOST TRAINING\n# =======================\nprint(\"\\n\" + \"=\"*60)\nprint(\"🚀 TRAINING CATBOOST MODEL\")\nprint(\"=\"*60)\n\n# Create CatBoost model with specific parameters\nmodel = CatBoostClassifier(\n    iterations=800,  # Number of trees to build\n    learning_rate=0.02,  # How much each tree contributes (smaller = more careful learning)\n    depth=6,  # Depth of each tree\n    l2_leaf_reg=15,  # Regularization to prevent overfitting\n    bootstrap_type='Bernoulli',  # How to sample data for each tree\n    subsample=0.8,  # Use 80% of data for each tree\n    eval_metric='MultiClass',  # Metric for multi-class classification\n    random_seed=42,  # For reproducibility\n    class_weights=class_weights,  # Use calculated class weights\n    border_count=32,  # Number of splits for numerical features\n    colsample_bylevel=0.8,  # Use 80% of features at each tree level\n    min_data_in_leaf=5,  # Minimum samples in leaf nodes\n    verbose=100  # Show progress every 100 iterations\n)\n\nprint(\"⏳ Training model... (this may take a while)\")\n# Train the model on training data\nmodel.fit(X_train, y_train)\n\nprint(\"\\n✅ Model training completed!\")\n\n# =======================\n# EVALUATION\n# =======================\nprint(\"\\n📈 Evaluating model performance...\")\n# Make predictions on training and test data\ny_train_pred = model.predict(X_train)\ny_test_pred  = model.predict(X_test)\n\n# Calculate accuracy scores\ntrain_acc = accuracy_score(y_train, y_train_pred)\ntest_acc  = accuracy_score(y_test, y_test_pred)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"📊 MODEL PERFORMANCE\")\nprint(\"=\"*60)\nprint(f\"✅ Train Accuracy: {train_acc:.4f}\")\nprint(f\"✅ Test Accuracy : {test_acc:.4f}\")\nprint(f\"📉 Overfitting Gap: {abs(train_acc - test_acc):.4f}\")  # Difference indicates overfitting\n\n# =======================\n# REPORT & CONFUSION MATRIX\n# =======================\n# Create label encoder for disease names\nle_target = LabelEncoder().fit(df_train['disease'])\n# Convert numerical predictions back to disease names\ny_test_labels = le_target.inverse_transform(y_test)\ny_pred_labels = le_target.inverse_transform(y_test_pred)\n\nprint(\"\\n📋 Classification Report:\")\n# Print detailed metrics for each class\nprint(classification_report(y_test_labels, y_pred_labels))\n\n# Create confusion matrix (shows correct vs incorrect predictions)\ncm = confusion_matrix(y_test_labels, y_pred_labels)\n\n# Plot confusion matrix as heatmap\nplt.figure(figsize=(8,6))\nsns.heatmap(\n    cm, annot=True, fmt='d', cmap='Blues',  # Annotate with counts, use blue color scheme\n    xticklabels=le_target.classes_,  # Disease names on x-axis\n    yticklabels=le_target.classes_   # Disease names on y-axis\n)\nplt.xlabel(\"Predicted\")  # X-axis label\nplt.ylabel(\"Actual\")     # Y-axis label\nplt.title(\"Confusion Matrix (Test Set)\")  # Plot title\nplt.tight_layout()  # Adjust layout\nplt.show()  # Display plot\n\n# Feature importance analysis\nif hasattr(model, 'feature_importance_'):\n    print(\"\\n📊 Top 20 Feature Importances:\")\n    # Get all feature names\n    feature_names = list(df_train_enc.drop(['candidateID','disease'], axis=1).columns) + list(train_audio.drop(audio_columns_to_drop, 
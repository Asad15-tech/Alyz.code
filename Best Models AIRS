    "# ==========================================================\n",
    "# 🚀 RANDOM FOREST TRAINING & EVALUATION (80/20 – NO VALIDATION)\n",
    "# ==========================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import scipy\n",
    "import pickle\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# =======================\n",
    "# PATHS & PARAMETERS\n",
    "# =======================\n",
    "SOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\n",
    "TRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\n",
    "TEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\n",
    "CACHE_FILE = \"/kaggle/working/audio_cache.pkl\"\n",
    "\n",
    "SR = 16000\n",
    "DURATION = 2\n",
    "TARGET_LEN = SR * DURATION\n",
    "N_MFCC = 30\n",
    "\n",
    "# =======================\n",
    "# LOAD DATA\n",
    "# =======================\n",
    "df_train = pd.read_csv(TRAIN_PATH)\n",
    "df_test  = pd.read_csv(TEST_PATH)\n",
    "\n",
    "for col in df_train.columns:\n",
    "    if df_train[col].isnull().sum() > 0:\n",
    "        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n",
    "\n",
    "for col in df_test.columns:\n",
    "    if df_test[col].isnull().sum() > 0:\n",
    "        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n",
    "\n",
    "# =======================\n",
    "# AUDIO FEATURE EXTRACTION\n",
    "# =======================\n",
    "def resample(y, orig_sr, target_sr=16000):\n",
    "    if orig_sr != target_sr:\n",
    "        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n",
    "    return y\n",
    "\n",
    "def pad_truncate(y, length):\n",
    "    return np.pad(y, (0, max(0, length - len(y))))[:length]\n",
    "\n",
    "def extract_audio(path):\n",
    "    try:\n",
    "        y, sr = librosa.load(path, sr=None)\n",
    "        y = resample(y, sr, SR)\n",
    "        y = pad_truncate(y, TARGET_LEN)\n",
    "\n",
    "        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n",
    "        delta = librosa.feature.delta(mfcc)\n",
    "        delta2 = librosa.feature.delta(mfcc, order=2)\n",
    "        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n",
    "        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n",
    "        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n",
    "        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n",
    "        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n",
    "\n",
    "        feats = np.concatenate([\n",
    "            mfcc.mean(1), mfcc.std(1),\n",
    "            delta.mean(1), delta.std(1),\n",
    "            delta2.mean(1), delta2.std(1),\n",
    "            chroma.mean(1), chroma.std(1),\n",
    "            contrast.mean(1), contrast.std(1),\n",
    "            tonnetz.mean(1),\n",
    "            mel.mean(1), mel.std(1),\n",
    "            [np.mean(tempogram)]\n",
    "        ])\n",
    "        return feats\n",
    "    except:\n",
    "        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1)\n",
    "\n",
    "def build_audio(df, cache=None):\n",
    "    if cache and os.path.exists(cache):\n",
    "        with open(cache, \"rb\") as f:\n",
    "            return pickle.load(f)\n",
    "\n",
    "    feats = [\n",
    "        extract_audio(os.path.join(SOUND_DIR, f\"{cid}.wav\"))\n",
    "        for cid in tqdm(df[\"candidateID\"])\n",
    "    ]\n",
    "\n",
    "    audio_df = pd.DataFrame(feats)\n",
    "    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n",
    "\n",
    "    if cache:\n",
    "        with open(cache, \"wb\") as f:\n",
    "            pickle.dump(audio_df, f)\n",
    "\n",
    "    return audio_df\n",
    "\n",
    "print(\"🎵 Extracting audio features...\")\n",
    "train_audio = build_audio(df_train, CACHE_FILE)\n",
    "\n",
    "# =======================\n",
    "# LABEL ENCODING\n",
    "# =======================\n",
    "categorical_cols = [\n",
    "    'gender','tbContactHistory','wheezingHistory',\n",
    "    'phlegmCough','familyAsthmaHistory',\n",
    "    'feverHistory','coldPresent'\n",
    "]\n",
    "\n",
    "df_train_enc = df_train.copy()\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n",
    "\n",
    "# =======================\n",
    "# MERGE FEATURES\n",
    "# =======================\n",
    "X = pd.concat([\n",
    "    df_train_enc.drop(['candidateID','disease'], axis=1),\n",
    "    train_audio.drop(['candidateID'], axis=1)\n",
    "], axis=1)\n",
    "\n",
    "y = LabelEncoder().fit_transform(df_train['disease'])\n",
    "\n",
    "# =======================\n",
    "# IMPUTE & SCALE\n",
    "# =======================\n",
    "X = SimpleImputer(strategy=\"most_frequent\").fit_transform(X)\n",
    "X = StandardScaler().fit_transform(X)\n",
    "\n",
    "# =======================\n",
    "# 80 / 20 TRAIN–TEST SPLIT\n",
    "# =======================\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    stratify=y,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(f\"✅ Train Samples: {X_train.shape[0]}\")\n",
    "print(f\"✅ Test Samples : {X_test.shape[0]}\")\n",
    "\n",
    "# =======================\n",
    "# CLASS WEIGHTS\n",
    "# =======================\n",
    "from collections import Counter\n",
    "counter = Counter(y_train)\n",
    "total = sum(counter.values())\n",
    "class_weights = {k: total/(len(counter)*v) for k,v in counter.items()}\n",
    "\n",
    "print(\"📊 Class Weights:\", class_weights)\n",
    "\n",
    "# =======================\n",
    "# 🌳 RANDOM FOREST MODEL\n",
    "# =======================\n",
    "model = RandomForestClassifier(\n",
    "    n_estimators=600,\n",
    "    max_depth=20,\n",
    "    min_samples_split=5,\n",
    "    min_samples_leaf=3,\n",
    "    max_features=\"sqrt\",\n",
    "    class_weight=class_weights,\n",
    "    n_jobs=-1,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "print(\"\\n✅ Model training completed!\")\n",
    "\n",
    "# =======================\n",
    "# EVALUATION\n",
    "# =======================\n",
    "y_train_pred = model.predict(X_train)\n",
    "y_test_pred  = model.predict(X_test)\n",
    "\n",
    "train_acc = accuracy_score(y_train, y_train_pred)\n",
    "test_acc  = accuracy_score(y_test, y_test_pred)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"📊 MODEL PERFORMANCE\")\n",
    "print(\"=\"*60)\n",
    "print(f\"✅ Train Accuracy: {train_acc:.4f}\")\n",
    "print(f\"✅ Test Accuracy : {test_acc:.4f}\")\n",
    "print(f\"📉 Overfitting Gap: {abs(train_acc - test_acc):.4f}\")\n",
    "\n",
    "# =======================\n",
    "# REPORT & CONFUSION MATRIX\n",
    "# =======================\n",
    "le_target = LabelEncoder().fit(df_train['disease'])\n",
    "y_test_labels = le_target.inverse_transform(y_test)\n",
    "y_pred_labels = le_target.inverse_transform(y_test_pred)\n",
    "\n",
    "print(\"\\n📋 Classification Report:\")\n",
    "print(classification_report(y_test_labels, y_pred_labels))\n",
    "\n",
    "cm = confusion_matrix(y_test_labels, y_pred_labels)\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "sns.heatmap(\n",
    "    cm, annot=True, fmt='d', cmap='Blues',\n",
    "    xticklabels=le_target.classes_,\n",
    "    yticklabels=le_target.classes_\n",
    ")\n",
    "plt.xlabel(\"Predicted\")\n",
    "plt.ylabel(\"Actual\")\n",
    "plt.title(\"Confusion Matrix (Test Set)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]

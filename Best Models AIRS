   "source": [
    "# ==========================================================\n",
    "# 🎯 SIMPLE & EFFECTIVE: Back to Basics + Micro-Tuning\n",
    "# Best previous: 86.36% - Let's push to 90%\n",
    "# ==========================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import scipy\n",
    "import pickle\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
    "from sklearn.feature_selection import SelectKBest, f_classif\n",
    "from catboost import CatBoostClassifier\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# =======================\n",
    "# PATHS & PARAMETERS\n",
    "# =======================\n",
    "SOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\n",
    "TRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\n",
    "TEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\n",
    "CACHE_FILE = \"/kaggle/working/audio_cache_enhanced.pkl\"\n",
    "\n",
    "SR = 16000\n",
    "DURATION = 2\n",
    "TARGET_LEN = SR * DURATION\n",
    "N_MFCC = 30\n",
    "\n",
    "# =======================\n",
    "# LOAD DATA\n",
    "# =======================\n",
    "print(\"📂 Loading data...\")\n",
    "df_train = pd.read_csv(TRAIN_PATH)\n",
    "df_test  = pd.read_csv(TEST_PATH)\n",
    "\n",
    "for col in df_train.columns:\n",
    "    if df_train[col].isnull().sum() > 0:\n",
    "        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n",
    "\n",
    "for col in df_test.columns:\n",
    "    if df_test[col].isnull().sum() > 0:\n",
    "        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n",
    "\n",
    "# =======================\n",
    "# ENHANCED AUDIO FEATURE EXTRACTION\n",
    "# =======================\n",
    "def resample(y, orig_sr, target_sr=16000):\n",
    "    if orig_sr != target_sr:\n",
    "        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n",
    "    return y\n",
    "\n",
    "def pad_truncate(y, length):\n",
    "    return np.pad(y, (0, max(0, length - len(y))))[:length]\n",
    "\n",
    "def extract_audio(path):\n",
    "    try:\n",
    "        y, sr = librosa.load(path, sr=None)\n",
    "        y = resample(y, sr, SR)\n",
    "        y = pad_truncate(y, TARGET_LEN)\n",
    "\n",
    "        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n",
    "        delta = librosa.feature.delta(mfcc)\n",
    "        delta2 = librosa.feature.delta(mfcc, order=2)\n",
    "        \n",
    "        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n",
    "        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n",
    "        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n",
    "        \n",
    "        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n",
    "        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n",
    "        \n",
    "        zcr = librosa.feature.zero_crossing_rate(y)\n",
    "        \n",
    "        spec_cent = librosa.feature.spectral_centroid(y=y, sr=SR)\n",
    "        spec_rolloff = librosa.feature.spectral_rolloff(y=y, sr=SR)\n",
    "        spec_bw = librosa.feature.spectral_bandwidth(y=y, sr=SR)\n",
    "        \n",
    "        rmse = librosa.feature.rms(y=y)\n",
    "\n",
    "        feats = np.concatenate([\n",
    "            mfcc.mean(1), mfcc.std(1),\n",
    "            delta.mean(1), delta.std(1),\n",
    "            delta2.mean(1), delta2.std(1),\n",
    "            chroma.mean(1), chroma.std(1),\n",
    "            contrast.mean(1), contrast.std(1),\n",
    "            tonnetz.mean(1),\n",
    "            mel.mean(1), mel.std(1),\n",
    "            [np.mean(tempogram)],\n",
    "            zcr.mean(1), zcr.std(1),\n",
    "            spec_cent.mean(1), spec_cent.std(1),\n",
    "            spec_rolloff.mean(1), spec_rolloff.std(1),\n",
    "            spec_bw.mean(1), spec_bw.std(1),\n",
    "            rmse.mean(1), rmse.std(1)\n",
    "        ])\n",
    "        return feats\n",
    "    except Exception as e:\n",
    "        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2)\n",
    "\n",
    "def build_audio(df, cache=None):\n",
    "    if cache and os.path.exists(cache):\n",
    "        print(f\"📦 Loading cached features from {cache}...\")\n",
    "        with open(cache, \"rb\") as f:\n",
    "            return pickle.load(f)\n",
    "\n",
    "    print(\"🎵 Extracting ENHANCED audio features...\")\n",
    "    feats = [\n",
    "        extract_audio(os.path.join(SOUND_DIR, f\"{cid}.wav\"))\n",
    "        for cid in tqdm(df[\"candidateID\"])\n",
    "    ]\n",
    "\n",
    "    audio_df = pd.DataFrame(feats)\n",
    "    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n",
    "\n",
    "    if cache:\n",
    "        with open(cache, \"wb\") as f:\n",
    "            pickle.dump(audio_df, f)\n",
    "\n",
    "    return audio_df\n",
    "\n",
    "train_audio = build_audio(df_train, CACHE_FILE)\n",
    "\n",
    "# =======================\n",
    "# LABEL ENCODING\n",
    "# =======================\n",
    "categorical_cols = [\n",
    "    'gender','tbContactHistory','wheezingHistory',\n",
    "    'phlegmCough','familyAsthmaHistory',\n",
    "    'feverHistory','coldPresent'\n",
    "]\n",
    "\n",
    "df_train_enc = df_train.copy()\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n",
    "\n",
    "# =======================\n",
    "# MERGE FEATURES\n",
    "# =======================\n",
    "X = pd.concat([\n",
    "    df_train_enc.drop(['candidateID','disease'], axis=1),\n",
    "    train_audio.drop(['candidateID'], axis=1)\n",
    "], axis=1)\n",
    "\n",
    "y = LabelEncoder().fit_transform(df_train['disease'])\n",
    "\n",
    "# =======================\n",
    "# IMPUTE & SCALE\n",
    "# =======================\n",
    "X_values = X.values\n",
    "imputer = SimpleImputer(strategy=\"most_frequent\")\n",
    "X_imputed = imputer.fit_transform(X_values)\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X = scaler.fit_transform(X_imputed)\n",
    "\n",
    "# =======================\n",
    "# FEATURE SELECTION (Keep original 500 or try optimal k)\n",
    "# =======================\n",
    "print(\"\\n🔍 Testing different feature selection thresholds...\")\n",
    "\n",
    "feature_thresholds = [350, 380, 400, 450, 500]  # More features = less aggressive filtering\n",
    "best_feature_k = None\n",
    "best_feature_acc = 0\n",
    "\n",
    "for k in feature_thresholds:\n",
    "    if k > X.shape[1]:\n",
    "        k = X.shape[1]\n",
    "    \n",
    "    selector = SelectKBest(f_classif, k=k)\n",
    "    X_selected = selector.fit_transform(X, y)\n",
    "    \n",
    "    X_train, X_test, y_train, y_test = train_test_split(\n",
    "        X_selected, y, test_size=0.20, stratify=y, random_state=42\n",
    "    )\n",
    "    \n",
    "    # Quick test with simple CatBoost\n",
    "    model_test = CatBoostClassifier(\n",
    "        iterations=1500,\n",
    "        learning_rate=0.008,\n",
    "        depth=4,\n",
    "        l2_leaf_reg=40,\n",
    "        subsample=0.75,\n",
    "        bootstrap_type='Bernoulli',\n",
    "        verbose=0,\n",
    "        random_seed=42\n",
    "    )\n",
    "    model_test.fit(X_train, y_train, eval_set=(X_test, y_test))\n",
    "    \n",
    "    test_acc = accuracy_score(y_test, model_test.predict(X_test))\n",
    "    \n",
    "    if test_acc > best_feature_acc:\n",
    "        best_feature_acc = test_acc\n",
    "        best_feature_k = k\n",
    "    \n",
    "    print(f\"  k={k:3d}: Test Acc = {test_acc:.4f}\")\n",
    "\n",
    "print(f\"\\n✅ Best feature threshold: k={best_feature_k} (accuracy: {best_feature_acc:.4f})\")\n",
    "\n",
    "# Use best feature count\n",
    "selector = SelectKBest(f_classif, k=best_feature_k)\n",
    "X = selector.fit_transform(X, y)\n",
    "print(f\"✅ Final features: 500 → {best_feature_k}\")\n",
    "\n",
    "# =======================\n",
    "# TRAIN-TEST SPLIT\n",
    "# =======================\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, stratify=y, random_state=42\n",
    ")\n",
    "\n",
    "print(f\"\\n✅ Train Samples: {X_train.shape[0]}\")\n",
    "print(f\"✅ Test Samples : {X_test.shape[0]}\")\n",
    "\n",
    "# =======================\n",
    "# TEST MULTIPLE CATBOOST CONFIGS (Simple tuning)\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"🎯 TESTING CATBOOST MICRO-CONFIGURATIONS\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "configs = [\n",
    "    # Based on what worked (86.36%)\n",
    "    {\n",
    "        'iterations': 3000,\n",
    "        'learning_rate': 0.005,\n",
    "        'depth': 5,\n",
    "        'l2_leaf_reg': 50,\n",
    "        'subsample': 0.7,\n",
    "        'name': 'Baseline (Original 86.36%)'\n",
    "    },\n",
    "    # Slight learning rate increase\n",
    "    {\n",
    "        'iterations': 2500,\n",
    "        'learning_rate': 0.007,\n",
    "        'depth': 5,\n",
    "        'l2_leaf_reg': 50,\n",
    "        'subsample': 0.7,\n",
    "        'name': 'Faster LR (lr=0.007)'\n",
    "    },\n",
    "    # More subsample\n",
    "    {\n",
    "        'iterations': 3000,\n",
    "        'learning_rate': 0.005,\n",
    "        'depth': 5,\n",
    "        'l2_leaf_reg': 50,\n",
    "        'subsample': 0.75,\n",
    "        'name': 'More Subsample (0.75)'\n",
    "    },\n",
    "    # Less regularization\n",
    "    {\n",
    "        'iterations': 3000,\n",
    "        'learning_rate': 0.005,\n",
    "        'depth': 5,\n",
    "        'l2_leaf_reg': 35,\n",
    "        'subsample': 0.7,\n",
    "        'name': 'Less Reg (l2=35)'\n",
    "    },\n",
    "    # Different depth\n",
    "    {\n",
    "        'iterations': 3000,\n",
    "        'learning_rate': 0.005,\n",
    "        'depth': 4,\n",
    "        'l2_leaf_reg': 50,\n",
    "        'subsample': 0.7,\n",
    "        'name': 'Simpler (depth=4)'\n",
    "    },\n",
    "]\n",
    "\n",
    "results = []\n",
    "\n",
    "for config in configs:\n",
    "    name = config.pop('name')\n",
    "    \n",
    "    model = CatBoostClassifier(\n",
    "        **config,\n",
    "        bootstrap_type='Bernoulli',\n",
    "        eval_metric='MultiClass',\n",
    "        random_seed=42,\n",
    "        verbose=0,\n",
    "        border_count=256,\n",
    "        colsample_bylevel=0.7,\n",
    "        min_data_in_leaf=15,\n",
    "        grow_policy='Lossguide'\n",
    "    )\n",
    "    \n",
    "    model.fit(X_train, y_train, eval_set=(X_test, y_test))\n",
    "    \n",
    "    y_train_pred = model.predict(X_train)\n",
    "    y_test_pred = model.predict(X_test)\n",
    "    train_acc = accuracy_score(y_train, y_train_pred)\n",
    "    test_acc = accuracy_score(y_test, y_test_pred)\n",
    "    gap = abs(train_acc - test_acc)\n",
    "    \n",
    "    results.append((name, model, train_acc, test_acc, gap))\n",
    "    \n",
    "    symbol = \"🚀\" if test_acc >= 0.90 else \"📈\" if test_acc >= 0.86 else \"⚠️\"\n",
    "    print(f\"\\n{symbol} {name}\")\n",
    "    print(f\"   Train: {train_acc:.4f} | Test: {test_acc:.4f} | Gap: {gap:.4f}\")\n",
    "\n",
    "# Find best\n",
    "best_name, best_model, best_train, best_test, best_gap = max(results, key=lambda x: x[3])\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(f\"🏆 BEST CONFIG: {best_name}\")\n",
    "print(f\"✅ Test Accuracy: {best_test:.4f} ({best_test*100:.2f}%)\")\n",
    "if best_test >= 0.90:\n",
    "    print(\"🎉 🎉 🎉 TARGET ACHIEVED: 90%+! 🎉 🎉 🎉\")\n",
    "else:\n",
    "    gap_to_90 = (0.90 - best_test) * 100\n",
    "    print(f\"📈 Gap to 90%: {gap_to_90:.2f}%\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# =======================\n",
    "# FINAL REPORT\n",
    "# =======================\n",
    "y_test_pred_final = best_model.predict(X_test)\n",
    "\n",
    "le_target = LabelEncoder().fit(df_train['disease'])\n",
    "y_test_labels = le_target.inverse_transform(y_test)\n",
    "y_pred_labels = le_target.inverse_transform(y_test_pred_final)\n",
    "\n",
    "print(\"\\n📋 CLASSIFICATION REPORT\")\n",
    "print(\"=\"*70)\n",
    "print(classification_report(y_test_labels, y_pred_labels))\n",
    "\n",
    "# =======================\n",
    "# CONFUSION MATRIX\n",
    "# =======================\n",
    "cm = confusion_matrix(y_test_labels, y_pred_labels)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(\n",
    "    cm, annot=True, fmt='d', cmap='RdYlGn',\n",
    "    xticklabels=le_target.classes_,\n",
    "    yticklabels=le_target.classes_,\n",
    "    cbar_kws={'label': 'Count'}\n",
    ")\n",
    "plt.xlabel(\"Predicted Label\", fontsize=12)\n",
    "plt.ylabel(\"True Label\", fontsize=12)\n",
    "plt.title(f\"Confusion Matrix - {best_name}\\nAccuracy: {best_test:.2%}\", fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.savefig('/tmp/confusion_matrix_simple.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()\n",
    "\n",
    "# =======================\n",
    "# PER-CLASS METRICS\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"📊 PER-CLASS PERFORMANCE\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "from sklearn.metrics import precision_score, recall_score, f1_score\n",
    "\n",
    "for i, disease in enumerate(le_target.classes_):\n",
    "    y_test_binary = (y_test == i).astype(int)\n",
    "    y_pred_binary = (y_test_pred_final == i).astype(int)\n",
    "    \n",
    "    prec = precision_score(y_test_binary, y_pred_binary, zero_division=0)\n",
    "    rec = recall_score(y_test_binary, y_pred_binary, zero_division=0)\n",
    "    f1 = f1_score(y_test_binary, y_pred_binary, zero_division=0)\n",
    "    \n",
    "    print(f\"{disease:15} | Precision: {prec:.4f} | Recall: {rec:.4f} | F1: {f1:.4f}\")\n",
    "\n",
    "print(\"\\n✅ OPTIMIZATION COMPLETE!\")"

    "# ==========================================================\n",
    "# 🚀 CATBOOST TRAINING & EVALUATION (80/20 – NO VALIDATION)\n",
    "# ==========================================================\n",
    "\n",
    "import os\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import librosa\n",
    "import scipy\n",
    "import pickle\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.impute import SimpleImputer\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score, classification_report, confusion_matrix\n",
    "from catboost import CatBoostClassifier\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# =======================\n",
    "# PATHS & PARAMETERS\n",
    "# =======================\n",
    "SOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\n",
    "TRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\n",
    "TEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\n",
    "CACHE_FILE = \"/kaggle/working/audio_cache.pkl\"\n",
    "\n",
    "SR = 16000\n",
    "DURATION = 2\n",
    "TARGET_LEN = SR * DURATION\n",
    "N_MFCC = 30\n",
    "\n",
    "# =======================\n",
    "# LOAD DATA\n",
    "# =======================\n",
    "print(\"📂 Loading data...\")\n",
    "df_train = pd.read_csv(TRAIN_PATH)\n",
    "df_test  = pd.read_csv(TEST_PATH)\n",
    "\n",
    "print(f\"✅ Train data shape: {df_train.shape}\")\n",
    "print(f\"✅ Test data shape: {df_test.shape}\")\n",
    "\n",
    "# Handle missing values\n",
    "for col in df_train.columns:\n",
    "    if df_train[col].isnull().sum() > 0:\n",
    "        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n",
    "\n",
    "for col in df_test.columns:\n",
    "    if df_test[col].isnull().sum() > 0:\n",
    "        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n",
    "\n",
    "# =======================\n",
    "# AUDIO FEATURE EXTRACTION\n",
    "# =======================\n",
    "def resample(y, orig_sr, target_sr=16000):\n",
    "    if orig_sr != target_sr:\n",
    "        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n",
    "    return y\n",
    "\n",
    "def pad_truncate(y, length):\n",
    "    return np.pad(y, (0, max(0, length - len(y))))[:length]\n",
    "\n",
    "def extract_audio(path):\n",
    "    try:\n",
    "        y, sr = librosa.load(path, sr=None)\n",
    "        \n",
    "        # Check if audio loaded successfully\n",
    "        if y is None or len(y) == 0:\n",
    "            print(f\"⚠️  WARNING: Empty audio file or failed to load: {os.path.basename(path)} - Using dummy features\")\n",
    "            return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False\n",
    "        \n",
    "        y = resample(y, sr, SR)\n",
    "        y = pad_truncate(y, TARGET_LEN)\n",
    "\n",
    "        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n",
    "        delta = librosa.feature.delta(mfcc)\n",
    "        delta2 = librosa.feature.delta(mfcc, order=2)\n",
    "        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n",
    "        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n",
    "        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n",
    "        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n",
    "        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n",
    "\n",
    "        feats = np.concatenate([\n",
    "            mfcc.mean(1), mfcc.std(1),\n",
    "            delta.mean(1), delta.std(1),\n",
    "            delta2.mean(1), delta2.std(1),\n",
    "            chroma.mean(1), chroma.std(1),\n",
    "            contrast.mean(1), contrast.std(1),\n",
    "            tonnetz.mean(1),\n",
    "            mel.mean(1), mel.std(1),\n",
    "            [np.mean(tempogram)]\n",
    "        ])\n",
    "        return feats, True\n",
    "    except Exception as e:\n",
    "        print(f\"❌ ERROR: Failed to process {os.path.basename(path)} - Error: {str(e)[:50]}... - Using dummy features\")\n",
    "        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False\n",
    "\n",
    "def build_audio(df, cache=None):\n",
    "    # Check if cache exists and is valid\n",
    "    if cache and os.path.exists(cache):\n",
    "        try:\n",
    "            print(\"📂 Loading audio features from cache...\")\n",
    "            with open(cache, \"rb\") as f:\n",
    "                audio_df = pickle.load(f)\n",
    "            print(f\"✅ Loaded {len(audio_df)} cached audio feature rows\")\n",
    "            \n",
    "            # Check if cache has the new format\n",
    "            if 'feature_extraction_success' not in audio_df.columns:\n",
    "                print(\"⚠️  Cache is in old format (no extraction tracking)\")\n",
    "                # Add dummy column for compatibility\n",
    "                audio_df['feature_extraction_success'] = True\n",
    "            return audio_df\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Error loading cache: {e}. Re-extracting features...\")\n",
    "    \n",
    "    print(\"🎵 Starting audio feature extraction from scratch...\")\n",
    "    feats = []\n",
    "    success_count = 0\n",
    "    total_count = len(df[\"candidateID\"])\n",
    "    \n",
    "    for cid in tqdm(df[\"candidateID\"], desc=\"Extracting audio features\"):\n",
    "        path = os.path.join(SOUND_DIR, f\"{cid}.wav\")\n",
    "        \n",
    "        # Check if file exists\n",
    "        if not os.path.exists(path):\n",
    "            print(f\"❌ FILE NOT FOUND: {cid}.wav - Using dummy features\")\n",
    "            feats.append((np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1), False))\n",
    "            continue\n",
    "            \n",
    "        feat, success = extract_audio(path)\n",
    "        feats.append((feat, success))\n",
    "        if success:\n",
    "            success_count += 1\n",
    "    \n",
    "    # Separate features and success flags\n",
    "    feat_arrays = [f[0] for f in feats]\n",
    "    success_flags = [f[1] for f in feats]\n",
    "    \n",
    "    # Create columns\n",
    "    cols = (\n",
    "        [f\"mfcc_mean_{i}\" for i in range(30)] +\n",
    "        [f\"mfcc_std_{i}\" for i in range(30)] +\n",
    "        [f\"delta_mean_{i}\" for i in range(30)] +\n",
    "        [f\"delta_std_{i}\" for i in range(30)] +\n",
    "        [f\"delta2_mean_{i}\" for i in range(30)] +\n",
    "        [f\"delta2_std_{i}\" for i in range(30)] +\n",
    "        [f\"chroma_mean_{i}\" for i in range(12)] +\n",
    "        [f\"chroma_std_{i}\" for i in range(12)] +\n",
    "        [f\"contrast_mean_{i}\" for i in range(7)] +\n",
    "        [f\"contrast_std_{i}\" for i in range(7)] +\n",
    "        [f\"tonnetz_{i}\" for i in range(6)] +\n",
    "        [f\"mel_mean_{i}\" for i in range(128)] +\n",
    "        [f\"mel_std_{i}\" for i in range(128)] +\n",
    "        [\"tempogram_mean\"]\n",
    "    )\n",
    "    \n",
    "    audio_df = pd.DataFrame(feat_arrays, columns=cols)\n",
    "    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n",
    "    audio_df[\"feature_extraction_success\"] = success_flags\n",
    "    \n",
    "    # Print summary\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"📊 AUDIO FEATURE EXTRACTION SUMMARY\")\n",
    "    print(\"=\"*60)\n",
    "    print(f\"✅ Original features extracted: {success_count}/{total_count} ({success_count/total_count*100:.1f}%)\")\n",
    "    print(f\"⚠️  Dummy features used: {total_count - success_count}/{total_count} ({(total_count-success_count)/total_count*100:.1f}%)\")\n",
    "    \n",
    "    if success_count < total_count:\n",
    "        failed_ids = df[\"candidateID\"][[not flag for flag in success_flags]].tolist()\n",
    "        print(f\"❌ Files with issues (first 10): {failed_ids[:10]}{'...' if len(failed_ids) > 10 else ''}\")\n",
    "    \n",
    "    if cache:\n",
    "        print(f\"💾 Caching features to {cache}...\")\n",
    "        with open(cache, \"wb\") as f:\n",
    "            pickle.dump(audio_df, f)\n",
    "        print(\"✅ Features cached successfully\")\n",
    "\n",
    "    return audio_df\n",
    "\n",
    "print(\"\\n🎵 Extracting audio features...\")\n",
    "train_audio = build_audio(df_train, CACHE_FILE)\n",
    "\n",
    "# =======================\n",
    "# LABEL ENCODING\n",
    "# =======================\n",
    "print(\"\\n🔤 Encoding categorical variables...\")\n",
    "categorical_cols = [\n",
    "    'gender','tbContactHistory','wheezingHistory',\n",
    "    'phlegmCough','familyAsthmaHistory',\n",
    "    'feverHistory','coldPresent'\n",
    "]\n",
    "\n",
    "df_train_enc = df_train.copy()\n",
    "\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n",
    "\n",
    "print(\"✅ Categorical encoding completed\")\n",
    "\n",
    "# =======================\n",
    "# MERGE FEATURES\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🔗 MERGING FEATURES\")\n",
    "print(\"=\"*60)\n",
    "print(f\"📊 Tabular data shape: {df_train_enc.drop(['candidateID','disease'], axis=1).shape}\")\n",
    "\n",
    "# Handle audio features - check if we have the new column\n",
    "if 'feature_extraction_success' in train_audio.columns:\n",
    "    print(\"✅ Using audio features with extraction success tracking\")\n",
    "    audio_columns_to_drop = ['candidateID', 'feature_extraction_success']\n",
    "    \n",
    "    # Calculate success rate\n",
    "    success_rate = train_audio['feature_extraction_success'].mean() * 100\n",
    "    print(f\"📊 Audio feature extraction success rate: {success_rate:.1f}%\")\n",
    "    print(f\"   - Successful: {train_audio['feature_extraction_success'].sum()}/{len(train_audio)}\")\n",
    "    print(f\"   - Failed: {len(train_audio) - train_audio['feature_extraction_success'].sum()}/{len(train_audio)}\")\n",
    "else:\n",
    "    print(\"⚠️  Using cached audio features (no extraction success tracking)\")\n",
    "    audio_columns_to_drop = ['candidateID']\n",
    "    print(\"ℹ️  Feature extraction statistics not available in cached data\")\n",
    "\n",
    "print(f\"🎵 Audio data shape: {train_audio.drop(audio_columns_to_drop, axis=1).shape}\")\n",
    "\n",
    "X = pd.concat([\n",
    "    df_train_enc.drop(['candidateID','disease'], axis=1),\n",
    "    train_audio.drop(audio_columns_to_drop, axis=1)\n",
    "], axis=1)\n",
    "\n",
    "y = LabelEncoder().fit_transform(df_train['disease'])\n",
    "\n",
    "print(f\"✅ Final feature matrix shape: {X.shape}\")\n",
    "\n",
    "# =======================\n",
    "# IMPUTE & SCALE\n",
    "# =======================\n",
    "print(\"\\n⚙️  Preprocessing features...\")\n",
    "imputer = SimpleImputer(strategy=\"most_frequent\")\n",
    "X = imputer.fit_transform(X)\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X = scaler.fit_transform(X)\n",
    "\n",
    "print(\"✅ Imputation and scaling completed\")\n",
    "\n",
    "# =======================\n",
    "# 80 / 20 TRAIN–TEST SPLIT\n",
    "# =======================\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X,\n",
    "    y,\n",
    "    test_size=0.20,\n",
    "    stratify=y,\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"📊 DATA SPLIT SUMMARY\")\n",
    "print(\"=\"*60)\n",
    "print(f\"✅ Train Samples: {X_train.shape[0]} ({X_train.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"✅ Test Samples : {X_test.shape[0]} ({X_test.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"✅ Number of features: {X_train.shape[1]}\")\n",
    "\n",
    "# =======================\n",
    "# CLASS WEIGHTS\n",
    "# =======================\n",
    "from collections import Counter\n",
    "counter = Counter(y_train)\n",
    "total = sum(counter.values())\n",
    "class_weights = {k: total/(len(counter)*v) for k,v in counter.items()}\n",
    "print(\"\\n📊 Class Distribution:\")\n",
    "for class_id, count in sorted(counter.items()):\n",
    "    print(f\"  Class {class_id}: {count} samples ({count/total*100:.1f}%)\")\n",
    "print(\"📊 Class Weights:\", class_weights)\n",
    "\n",
    "# =======================\n",
    "# CATBOOST TRAINING\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🚀 TRAINING CATBOOST MODEL\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "model = CatBoostClassifier(\n",
    "    iterations=800,\n",
    "    learning_rate=0.02,\n",
    "    depth=6,\n",
    "    l2_leaf_reg=15,\n",
    "    bootstrap_type='Bernoulli',\n",
    "    subsample=0.8,\n",
    "    eval_metric='MultiClass',\n",
    "    random_seed=42,\n",
    "    class_weights=class_weights,\n",
    "    border_count=32,\n",
    "    colsample_bylevel=0.8,\n",
    "    min_data_in_leaf=5,\n",
    "    verbose=100\n",
    ")\n",
    "\n",
    "print(\"⏳ Training model... (this may take a while)\")\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "print(\"\\n✅ Model training completed!\")\n",
    "\n",
    "# =======================\n",
    "# EVALUATION\n",
    "# =======================\n",
    "print(\"\\n📈 Evaluating model performance...\")\n",
    "y_train_pred = model.predict(X_train)\n",
    "y_test_pred  = model.predict(X_test)\n",
    "\n",
    "train_acc = accuracy_score(y_train, y_train_pred)\n",
    "test_acc  = accuracy_score(y_test, y_test_pred)\n",
    "\n",
    "print(\"\\n\" + \"=\"*60)\n",

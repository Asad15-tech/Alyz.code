d(1),\n            contrast.mean(1), contrast.std(1),\n            tonnetz.mean(1),\n            mel.mean(1), mel.std(1),\n            [np.mean(tempogram)],\n            zcr.mean(1), zcr.std(1),\n            spec_cent.mean(1), spec_cent.std(1),\n            spec_rolloff.mean(1), spec_rolloff.std(1),\n            spec_bw.mean(1), spec_bw.std(1),\n            rmse.mean(1), rmse.std(1)\n        ])\n        return feats\n    except Exception as e:\n        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2)\n\ndef build_audio(df, cache=None):\n    if cache and os.path.exists(cache):\n        print(f\"📦 Loading cached features from {cache}...\")\n        with open(cache, \"rb\") as f:\n            return pickle.load(f)\n\n    print(\"🎵 Extracting ENHANCED audio features...\")\n    feats = [\n        extract_audio(os.path.join(SOUND_DIR, f\"{cid}.wav\"))\n        for cid in tqdm(df[\"candidateID\"])\n    ]\n\n    audio_df = pd.DataFrame(feats)\n    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n\n    if cache:\n        with open(cache, \"wb\") as f:\n            pickle.dump(audio_df, f)\n\n    return audio_df\n\ntrain_audio = build_audio(df_train, CACHE_FILE)\n\n# =======================\n# LABEL ENCODING\n# =======================\ncategorical_cols = [\n    'gender','tbContactHistory','wheezingHistory',\n    'phlegmCough','familyAsthmaHistory',\n    'feverHistory','coldPresent'\n]\n\ndf_train_enc = df_train.copy()\nfor col in categorical_cols:\n    le = LabelEncoder()\n    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n\n# =======================\n# MERGE FEATURES\n# =======================\nX = pd.concat([\n    df_train_enc.drop(['candidateID','disease'], axis=1),\n    train_audio.drop(['candidateID'], axis=1)\n], axis=1)\n\ny = LabelEncoder().fit_transform(df_train['disease'])\n\n# =======================\n# IMPUTE & SCALE\n# =======================\nX_values = X.values\n\nimputer = SimpleImputer(strategy=\"most_frequent\")\nX_imputed = imputer.fit_transform(X_values)\n\nscaler = StandardScaler()\nX = scaler.fit_transform(X_imputed)\n\n# =======================\n# FEATURE SELECTION (Remove Noise)\n# =======================\nprint(\"\\n🔍 Selecting best features...\")\nselector = SelectKBest(f_classif, k=250)  # Keep 250 best features\nX = selector.fit_transform(X, y)\nprint(f\"✅ Reduced features: 500 → 250\")\n\n# =======================\n# TRAIN-TEST SPLIT\n# =======================\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.20, stratify=y, random_state=42\n)\n\nprint(f\"\\n✅ Train Samples: {X_train.shape[0]}\")\nprint(f\"✅ Test Samples : {X_test.shape[0]}\")\n\n# =======================\n# CLASS WEIGHTS\n# =======================\nprint(\"\\n⚖️  Computing class weights for imbalance...\")\nweights = class_weight.compute_class_weight(\n    class_weight='balanced',\n    classes=np.unique(y_train),\n    y=y_train\n)\nclass_weights_dict = {i: weights[i] for i in range(len(weights))}\nprint(f\"📊 Class Weights: {class_weights_dict}\")\n\n# =======================\n# TRAIN FINE-TUNED MODELS\n# =======================\nprint(\"\\n\" + \"=\"*70)\nprint(\"🚀 TRAINING OPTIMIZED ENSEMBLE\")\nprint(\"=\"*70)\n\nprint(\"\\n📚 Training Base Learners...\\n\")\n\n# Model 1: Fine-tuned CatBoost\nprint(\"🔵 Training CatBoost (Extreme Tuning)...\")\nmodel_catboost = CatBoostClassifier(\n    iterations=1500,\n    learning_rate=0.01,\n    depth=5,\n    l2_leaf_reg=30,\n    bootstrap_type='Bernoulli',\n    subsample=0.8,\n    eval_metric='MultiClass',\n    random_seed=42,\n    class_weights=class_weights_dict,\n    verbose=0,\n    border_count=128,\n    colsample_bylevel=0.8,\n    min_data_in_leaf=10,\n    grow_policy='Lossguide'\n)\nmodel_catboost.fit(X_train, y_train)\nprint(\"   ✅ CatBoost trained\")\n\n# Model 2: Fine-tuned XGBoost\nprint(\"🟡 Training XGBoost (Extreme Tuning)...\")\nmodel_xgb = XGBClassifier(\n    n_estimators=1500,\n    max_depth=5,\n    learning_rate=0.01,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    colsample_bylevel=0.8,\n    gamma=2,\n    min_child_weight=5,\n    reg_alpha=0.5,\n    reg_lambda=1.0,\n    random_state=42,\n    tree_method='hist',\n    n_jobs=-1,\n    eval_metric='mlogloss'\n)\nmodel_xgb.fit(X_train, y_train)\nprint(\"   ✅ XGBoost trained\")\n\n# Model 3: Fine-tuned Gradient Boosting\nprint(\"🟠 Training Gradient Boosting (Extreme Tuning)...\")\nmodel_gb = GradientBoostingClassifier(\n    n_estimators=1000,\n    learning_rate=0.01,\n    max_depth=5,\n    min_samples_split=8,\n    min_samples_leaf=5,\n    subsample=0.8,\n    max_features='sqrt',\n    validation_fraction=0.15,\n    n_iter_no_change=50,\n    random_state=42\n)\nmodel_gb.fit(X_train, y_train)\nprint(\"   ✅ Gradient Boosting trained\")\n\n# =======================\n# ENSEMBLE PREDICTIONS\n# =======================\nprint(\"\\n🗳️  Creating Ensemble Predictions...\")\n\n# Hard Voting (Majority Vote)\npred_test_cb = model_catboost.predict(X_test)\npred_test_xgb = model_xgb.predict(X_test)\npred_test_gb = model_gb.predict(X_test)\n\n# Stack predictions and find mode\ny_test_hard = mode(np.column_stack([pred_test_cb, pred_test_xgb, pred_test_gb]), axis=1, keepdims=False)[0]\n\n# Soft Voting (Weighted Average of Probabilities)\ntest_prob_cb = model_catboost.predict_proba(X_test)\ntest_prob_xgb = model_xgb.predict_proba(X_test)\ntest_prob_gb = model_gb.predict_proba(X_test)\n\nweights = [3, 2, 2]  # CatBoost gets highest weight\nweights_norm = [w / sum(weights) for w in weights]\n\ny_test_soft = np.argmax(\n    weights_norm[0] * test_prob_cb + weights_norm[1] * test_prob_xgb + weights_norm[2] * test_prob_gb,\n    axis=1\n)\n\n# =======================\n# EVALUATION\n# =======================\nprint(\"\\n\" + \"=\"*70)\nprint(\"📊 MODEL PERFORMANCE COMPARISON\")\nprint(\"=\"*70)\n\nresults = []\n\n# Individual models\nfor name, model in [\n    (\"CatBoost\", model_catboost),\n    (\"XGBoost\", model_xgb),\n    (\"Gradient Boosting\", model_gb)\n]:\n    y_train_pred = model.predict(X_train)\n    y_test_pred = model.predict(X_test)\n    train_acc = accuracy_score(y_train, y_train_pred)\n    test_acc = accuracy_score(y_test, y_test_pred)\n    gap = abs(train_acc - test_acc)\n    results.append((name, train_acc, test_acc, gap))\n\n# Hard Voting\ntest_acc_hard = accuracy_score(y_test, y_test_hard)\nresults.append((\"Hard Voting\", None, test_acc_hard, None))\n\n# Soft Voting\ntest_acc_soft = accuracy_score(y_test, y_test_soft)\nresults.append((\"Soft Voting (3-2-2)\", None, test_acc_soft, None))\n\n# Print results\nfor name, train_acc, test_acc, gap in results:\n    symbol = \"🚀\" if test_acc >= 0.90 else \"📈\" if test_acc >= 0.85 else \"✅\"\n    if train_acc is not None:\n        print(f\"\\n{symbol} {name:25}\")\n        print(f\"   Train: {train_acc:.4f} ({train_acc*100:.2f}%)\")\n        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n        print(f\"   Gap:   {gap:.4f}\")\n    else:\n        print(f\"\\n{symbol} {name:25}\")\n        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n\n# Find best model\nbest_result = max([r for r in results if r[2] is not None], key=lambda x: x[2])\nbest_name, best_train, best_test, best_gap = best_result\n\nprint(\"\\n\" + \"=\"*70)\nprint(f\"🏆 BEST MODEL: {best_name}\")\nprint(f\"✅ Test Accuracy: {best_test:.4f} ({best_test*100:.2f}%)\")\nif best_test >= 0.90:\n    print(\"🎉 TARGET ACHIEVED: 90%+!\")\nelse:\n    print(f\"📈 Gap to 90%: {(0.90 - best_test)*100:.2f}%\")\nprint(\"=\"*70)\n\n# Use best ensemble method\nif test_acc_hard >= test_acc_soft:\n    y_test_pred_final = y_test_hard\n    print(\"🏅 Using Hard Voting Ensemble\")\nelse:\n    y_test_pred_final = y_test_soft\n    print(\"🏅 Using Soft Voting Ensemble\")\n\n# =======================\n# DETAILED REPORT\n# =======================\nle_target = LabelEncoder().fit(df_train['disease'])\ny_test_labels = le_target.inverse_transform(y_test)\ny_pred_labels = le_target.inverse_transform(y_test_pred_final)\n\nprint(\"\\n📋 CLASSIFICATION REPORT\")\nprint(\"=\"*70)\nprint(classification_report(y_test_labels, y_pred_labels))\n\n# =======================\n# CONFUSION MATRIX\n# =======================\ncm = confusion_matrix(y_test_labels, y_pred_labels)\n\nplt.figure(figsize=(10, 8))\nsns.heatmap(\n    cm, annot=True, fmt='d', cmap='RdYlGn',\n    xticklabels=le_target.classes_,\n    yticklabels=le_target.classes_,\n    cbar_kws={'label': 'Count'}\n)\nplt.xlabel(\"Predicted Label\", fontsize=12)\nplt.ylabel(\"True Label\", fontsize=12)\nplt.title(f\"Confusion Matrix - Ensemble Model\\nAccuracy: {max(test_acc_hard, test_acc_soft):.2%}\", fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()\n\nprint(\"\\n✅ TRAINING COMPLETE!\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# 🚀 RANDOM FOREST TRAINING & EVALUATION (80/20 – NO VALIDATION)\n# ==========================================================\n\nimport os\nimport numpy as np\nimport pandas as pd\nimport librosa\nimport scipy\nimport pickle\nfrom tqdm import tqdm\nimport warnings\nwarnings.filterwarnings(\"ignore\")\n\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix\nfrom sklearn.ensemble import RandomForestClassifier\n\nimport seaborn as sns\nimport matplotlib.pyplot as plt\n\n# =======================\n# PATHS & PARAMETERS\n# =======================\nSOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\nTRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\nTEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\nCACHE_FILE = \"/kaggle/working/audio_cache.pkl\"\n\nSR = 16000\nDURATION = 2\nTARGET_LEN = SR * DURATION\nN_MFCC = 30\n\n# =======================\n# LOAD DATA\n# =======================\ndf_train = pd.read_csv(TRAIN_PATH)\ndf_test  = pd.read_csv(TEST_PATH)\n\nfor col in df_train.columns:\n    if df_train[col].isnull().sum() > 0:\n        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n\nfor col in df_test.columns:\n    if df_test[col].isnull().sum() > 0:\n        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n\n# =======================\n# AUDIO FEATURE EXTRACTION\n# =======================\ndef resample(y, orig_sr, target_sr=16000):\n    if orig_sr != target_sr:\n        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n    return y\n\ndef pad_truncate(y, length):\n    return np.pad(y, (0, max(0, length - len(y))))[:length]\n\ndef extract_audio(path):\n    try:\n        y, sr = librosa.load(path, sr=None)\n        y = resample(y, sr, SR)\n        y = pad_truncate(y, TARGET_LEN)\n\n        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n        delta = librosa.feature.delta(mfcc)\n        delta2 = librosa.feature.delta(mfcc, order=2)\n        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n\n        feats = np.concatenate([\n            mfcc.mean(1), mfcc.std(1),\n            delta.mean(1), delta.std(1),\n            delta2.mean(1), delta2.std(1),\n            chroma.mean(1), chroma.std(1),\n            contrast.mean(1), contrast.std(1),\n            tonnetz.mean(1),\n            mel.mean(1), mel.std(1),\n            [np.mean(tempogram)]\n        ])\n        return feats\n    except:\n        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1)\n\ndef build_audio(df, cache=None):\n    if cache and os.path.exists(cache):\n        with open(cache, \"rb\") as f:\n            return pickle.load(f)\n\n    feats = [\n        extract_audio(os.path.join(SOUND_DIR, f\"{cid}.wav\"))\n        for cid in tqdm(df[\"candidateID\"])\n    ]\n\n    audio_df = pd.DataFrame(feats)\n    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n\n    if cache:\n        with open(cache, \"wb\") as f:\n            pickle.dump(audio_df, f)\n\n    return audio_df\n\nprint(\"🎵 Extracting audio features...\")\ntrain_audio = build_audio(df_train, CACHE_FILE)\n\n# =======================\n# LABEL ENCODING\n# =======================\ncategorical_cols = [\n    'gender','tbContactHistory','wheezingHistory',\n    'phlegmCough','familyAsthmaHistory',\n    'feverHistory','coldPresent'\n]\n\ndf_train_enc = df_train.copy()\nfor col in categorical_cols:\n    le = LabelEncoder()\n    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n\n# =======================\n# MERGE FEATURES\n# =======================\nX = pd.concat([\n    df_train_enc.drop(['candidateID','disease'], axis=1),\n    train_audio.drop(['candidateID'], axis=1)\n], axis=1)\n\ny = LabelEncoder().fit_transform(df_train['disease'])\n\n# =======================\n# IMPUTE & SCALE\n# =======================\nX = SimpleImputer(strategy=\"most_frequent\").fit_transform(X)\nX = StandardScaler().fit_transform(X)\n\n# =======================\n# 80 / 20 TRAIN–TEST SPLIT\n# =======================\nX_train, X_test, y_train, y_test = train_test_split(\n    X,\n    y,\n    test_size=0.20,\n    stratify=y,\n    random_state=42\n)\n\nprint(f\"✅ Train Samples: {X_train.shape[0]}\")\nprint(f\"✅ Test Samples : {X_test.shape[0]}\")\n\n# =======================\n# CLASS WEIGHTS\n# =======================\nfrom collections import Counter\ncounter = Counter(y_train)\ntotal = sum(counter.values())\nclass_weights = {k: total/(len(counter)*v) for k,v in counter.items()}\n\nprint(\"📊 Class Weights:\", class_weights)\n\n# =======================\n# 🌳 RANDOM FOREST MODEL\n# =======================\nmodel = RandomForestClassifier(\n    n_estimators=600,\n    max_depth=20,\n    min_samples_split=5,\n    min_samples_leaf=3,\n    max_features=\"sqrt\",\n    class_weight=class_weights,\n    n_jobs=-1,\n    random_state=42\n)\n\nmodel.fit(X_train, y_train)\n\nprint(\"\\n✅ Model training completed!\")\n\n# =======================\n# EVALUATION\n# =======================\ny_train_pred = model.predict(X_train)\ny_test_pred  = model.predict(X_test)\n\ntrain_acc = accuracy_score(y_train, y_train_pred)\ntest_acc  = accuracy_score(y_test, y_test_pred)\n\nprint(\"\\n\" + \"=\"*60)\nprint(\"📊 MODEL PERFORMANCE\")\nprint(\"=\"*60)\nprint(f\"✅ Train Accuracy: {train_acc:.4f}\")\nprint(f\"✅ Test Accuracy : {test_acc:.4f}\")\nprint(f\"📉 Overfitting Gap: {abs(train_acc - test_acc):.4f}\")\n\n# =======================\n# REPORT & CONFUSION MATRIX\n# =======================\nle_target = LabelEncoder().fit(df_train['disease'])\ny_test_labels = le_target.inverse_transform(y_test)\ny_pred_labels = le_target.inverse_transform(y_test_pred)\n\nprint(\"\\n📋 Classification Report:\")\nprint(classification_report(y_test_labels, y_pred_labels))\n\ncm = confusion_matrix(y_test_labels, y_pred_labels)\n\nplt.figure(figsize=(8,6))\nsns.heatmap(\n    cm, annot=True, fmt='d', cmap='Blues',\n    xticklabels=le_target.classes_,\n    yticklabels=le_target.classes_\n)\nplt.xlabel(\"Predicted\")\nplt.ylabel(\"Actual\")\nplt.title(\"Confusion Matrix (Test Set)\")\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# 🚀 OPTIMIZED: Fine-tuned Ensemble WITHOUT SMOTE\n# TARGET: 90%+ ACCURACY (WITH AUDIO FEATURE TRACKING)\n# ==========================================================\n\nimport os\nimport numpy as np\nimport pandas as pd\nimport librosa\nimport scipy\nimport pickle\nfrom tqdm import tqdm\nimport warnings\nwarnings.filterwarnings(\"ignore\")\n\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix\nfrom sklearn.ensemble import GradientBoostingClassifier\nfrom sklearn.feature_selection import SelectKBest, f_classif\nfrom sklearn.utils import class_weight\nfrom catboost import CatBoostClassifier\nfrom xgboost import XGBClassifier\nimport seaborn as sns\nimport matplotlib.pyplot as plt\nfrom scipy.stats import mode\n\n# =======================\n# PATHS & PARAMETERS\n# =======================\nSOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\nTRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\nTEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\nCACHE_FILE = \"/kaggle/working/audio_cache_enhanced.pkl\"\n\nSR = 16000\nDURATION = 2\nTARGET_LEN = SR * DURATION\nN_MFCC = 30\n\n# =======================\n# LOAD DATA\n# =======================\nprint(\"📂 Loading data...\")\ndf_train = pd.read_csv(TRAIN_PATH)\ndf_test  = pd.read_csv(TEST_PATH)\n\nprint(f\"✅ Train data shape: {df_train.shape}\")\nprint(f\"✅ Test data shape: {df_test.shape}\")\n\nfor col in df_train.columns:\n    if df_train[col].isnull().sum() > 0:\n        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n\nfor col in df_test.columns:\n    if df_test[col].isnull().sum() > 0:\n        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n\n# =======================\n# ENHANCED AUDIO FEATURE EXTRACTION WITH TRACKING\n# =======================\ndef resample(y, orig_sr, target_sr=16000):\n    if orig_sr != target_sr:\n        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n    return y\n\ndef pad_truncate(y, length):\n    return np.pad(y, (0, max(0, length - len(y))))[:length]\n\ndef extract_audio(path):\n    \"\"\"Extract audio features and track if original or dummy features are used\"\"\"\n    try:\n        y, sr = librosa.load(path, sr=None)\n        \n        # Check if audio loaded successfully\n        if y is None or len(y) == 0:\n            print(f\"⚠️  AUDIO ERROR: Empty file - {os.path.basename(path)}\")\n            return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2), False\n        \n        y = resample(y, sr, SR)\n        y = pad_truncate(y, TARGET_LEN)\n\n        # MFCC & Deltas\n        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n        delta = librosa.feature.delta(mfcc)\n        delta2 = librosa.feature.delta(mfcc, order=2)\n        \n        # Chroma & Contrast\n        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n        \n        # Mel & Tempogram\n        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n        \n        # Zero Crossing Rate\n        zcr = librosa.feature.zero_crossing_rate(y)\n        \n        # Spectral features\n        spec_cent = librosa.feature.spectral_centroid(y=y, sr=SR)\n        spec_rolloff = librosa.feature.spectral_rolloff(y=y, sr=SR)\n        spec_bw = librosa.feature.spectral_bandwidth(y=y, sr=SR)\n        \n        # RMSE Energy\n        rmse = librosa.feature.rms(y=y)\n\n        feats = np.concatenate([\n            mfcc.mean(1), mfcc.std(1),\n            delta.mean(1), delta.std(1),\n            delta2.mean(1), delta2.std(1),\n            chroma.mean(1), chroma.std(1),\n            contrast.mean(1), contrast.std(1),\n            tonnetz.mean(1),\n            mel.mean(1), mel.std(1),\n            [np.mean(tempogram)],\n            zcr.mean(1), zcr.std(1),\n            spec_cent.mean(1), spec_cent.std(1),\n            spec_rolloff.mean(1), spec_rolloff.std(1),\n            spec_bw.mean(1), spec_bw.std(1),\n            rmse.mean(1), rmse.std(1)\n        ])\n        print(f\"✅ ORIGINAL FEATURES: {os.path.basename(path)}\")\n        return feats, True\n        \n    except Exception as e:\n        print(f\"❌ EXTRACTION ERROR: {os.path.basename(path)} - {str(e)[:50]}\")\n        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2), False\n\ndef build_audio(df, cache=None):\n    \"\"\"Build audio features with tracking\"\"\"\n    \n    # Check if cache exists and load it\n    if cache and os.path.exists(cache):\n        try:\n            print(\"📦 Loading cached features from {cache}...\")\n            with open(cache, \"rb\") as f:\n                audio_df = pickle.load(f)\n            print(f\"✅ Loaded {len(audio_df)} cached audio feature rows\")\n            \n            # Check if cache has success tracking column\n            if 'extraction_success' not in audio_df.columns:\n                print(\"⚠️  Cache is in old format (no extraction tracking)\")\n                # Add success column assuming all were successful\n                audio_df['extraction_success'] = True\n                audio_df['original_features_used'] = True\n            return audio_df\n        except Exception as e:\n            print(f\"❌ Cache loading error: {e}. Re-extracting features...\")\n    \n    print(\"\\n🎵 EXTRACTING ENHANCED AUDIO FEATURES FROM SCRATCH...\")\n    print(\"=\"*60)\n    \n    feats = []\n    success_list = []\n    total_files = len(df[\"candidateID\"])\n    success_count = 0\n    fail_count = 0\n    \n    for cid in tqdm(df[\"candidateID\"], desc=\"Processing audio files\"):\n        path = os.path.join(SOUND_DIR, f\"{cid}.wav\")\n        \n        # Check if file exists\n        if not os.path.exists(path):\n            print(f\"❌ FILE NOT FOUND: {cid}.wav - Using DUMMY features\")\n            feats.append(np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2))\n            success_list.append(False)\n            fail_count += 1\n            continue\n            \n        feat, success = extract_audio(path)\n        feats.append(feat)\n        success_list.append(success)\n        \n        if success:\n            success_count += 1\n        else:\n            fail_count += 1\n    \n    # Create audio dataframe\n    audio_df = pd.DataFrame(feats)\n    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n    audio_df[\"extraction_success\"] = success_list\n    audio_df[\"original_features_used\"] = success_list\n    \n    # Print summary\n    print(\"\\n\" + \"=\"*60)\n    print(\"📊 AUDIO FEATURE EXTRACTION SUMMARY\")\n    print(\"=\"*60)\n    print(f\"✅ TOTAL FILES PROCESSED: {total_files}\")\n    print(f\"🎯 ORIGINAL FEATURES USED: {success_count} ({success_count/total_files*100:.1f}%)\")\n    print(f\"⚠️  DUMMY FEATURES USED: {fail_count} ({fail_count/total_files*100:.1f}%)\")\n    print(\"=\"*60)\n    \n    if fail_count > 0:\n        failed_ids = df[\"candidateID\"][[not s for s in success_list]].tolist()\n        print(f\"📋 Files with dummy features (first 10): {failed_ids[:10]}{'...' if len(failed_ids) > 10 else ''}\")\n    \n    if cache:\n        print(f\"\\n💾 Caching features to {cache}...\")\n        with open(cache, \"wb\") as f:\n            pickle.dump(audio_df, f)\n        print(\"✅ Features cached successfully\")\n    \n    return audio_df\n\nprint(\"\\n🎵 Extracting audio features...\")\ntrain_audio = build_audio(df_train, CACHE_FILE)\n\n# =======================\n# LABEL ENCODING\n# =======================\nprint(\"\\n🔤 Encoding categorical variables...\")\ncategorical_cols = [\n    'gender','tbContactHistory','wheezingHistory',\n    'phlegmCough','familyAsthmaHistory',\n    'feverHistory','coldPresent'\n]\n\ndf_train_enc = df_train.copy()\nfor col in categorical_cols:\n    le = LabelEncoder()\n    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n\nprint(\"✅ Categorical encoding completed\")\n\n# =======================\n# MERGE FEATURES WITH AUDIO STATUS CHECK\n# =======================\nprint(\"\\n\" + \"=\"*60)\nprint(\"🔗 MERGING FEATURES WITH AUDIO STATUS\")\nprint(\"=\"*60)\n\n# Check audio feature status\nif 'extraction_success' in train_audio.columns:\n    success_rate = train_audio['extraction_success'].mean() * 100\n    print(f\"📊 AUDIO STATUS: {success_rate:.1f}% original features ({train_audio['extraction_success'].sum()}/{len(train_audio)})\")\nelse:\n    print(\"⚠️  Audio extraction status not available in cache\")\n\n# Prepare columns to drop\naudio_columns_to_drop = ['candidateID']\nif 'extraction_success' in train_audio.columns:\n    audio_columns_to_drop.append('extraction_success')\nif 'original_features_used' in train_audio.columns:\n    audio_columns_to_drop.append('original_features_used')\n\nprint(f\"📊 Tabular data shape: {df_train_enc.drop(['candidateID','disease'], axis=1).shape}\")\nprint(f\"🎵 Audio data shape: {train_audio.drop(audio_columns_to_drop, axis=1).shape}\")\n\n# Merge features\nX = pd.concat([\n    df_train_enc.drop(['candidateID','disease'], axis=1),\n    train_audio.drop(audio_columns_to_drop, axis=1)\n], axis=1)\n\ny = LabelEncoder().fit_transform(df_train['disease'])\n\nprint(f\"✅ Final feature matrix shape: {X.shape}\")\n\n# =======================\n# IMPUTE & SCALE\n# =======================\nprint(\"\\n⚙️  Preprocessing features...\")\nX_values = X.values\n\nimputer = SimpleImputer(strategy=\"most_frequent\")\nX_imputed = imputer.fit_transform(X_values)\n\nscaler = StandardScaler()\nX = scaler.fit_transform(X_imputed)\n\nprint(\"✅ Imputation and scaling completed\")\n\n# =======================\n# FEATURE SELECTION (Remove Noise)\n# =======================\nprint(\"\\n🔍 Selecting best features...\")\nselector = SelectKBest(f_classif, k=250)  # Keep 250 best features\nX = selector.fit_transform(X, y)\nprint(f\"✅ Reduced features: 500 → 250\")\n\n# =======================\n# TRAIN-TEST SPLIT\n# =======================\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.20, stratify=y, random_state=42\n)\n\nprint(f\"\\n📊 DATA SPLIT:\")\nprint(f\"✅ Train Samples: {X_train.shape[0]} ({X_train.shape[0]/len(X)*100:.1f}%)\")\nprint(f\"✅ Test Samples : {X_test.shape[0]} ({X_test.shape[0]/len(X)*100:.1f}%)\")\nprint(f\"✅ Features per sample: {X_train.shape[1]}\")\n\n# =======================\n# CLASS WEIGHTS (for imbalanced classes)\n# =======================\nprint(\"\\n⚖️  Computing class weights for imbalance...\")\nweights = class_weight.compute_class_weight(\n    class_weight='balanced',\n    classes=np.unique(y_train),\n    y=y_train\n)\nclass_weights_dict = {i: weights[i] for i in range(len(weights))}\nprint(f\"📊 Class Weights: {class_weights_dict}\")\n\n# Class distribution\nunique, counts = np.unique(y_train, return_counts=True)\nfor cls, cnt in zip(unique, counts):\n    print(f\"   Class {cls}: {cnt} samples ({cnt/len(y_train)*100:.1f}%)\")\n\n# =======================\n# TRAIN FINE-TUNED MODELS\n# =======================\nprint(\"\\n\" + \"=\"*70)\nprint(\"🚀 TRAINING OPTIMIZED ENSEMBLE (WITH AUDIO TRACKING)\")\nprint(\"=\"*70)\n\nprint(\"\\n📚 Training Base Learners...\\n\")\n\n# Model 1: Fine-tuned CatBoost\nprint(\"🔵 Training CatBoost (Extreme Tuning)...\")\nmodel_catboost = CatBoostClassifier(\n    iterations=1500,\n    learning_rate=0.01,\n    depth=5,\n    l2_leaf_reg=30,\n    bootstrap_type='Bernoulli',\n    subsample=0.8,\n    eval_metric='MultiClass',\n    random_seed=42,\n    class_weights=class_weights_dict,\n    verbose=0,\n    border_count=128,\n    colsample_bylevel=0.8,\n    min_data_in_leaf=10,\n    grow_policy='Lossguide'\n)\nmodel_catboost.fit(X_train, y_train)\nprint(\"   ✅ CatBoost trained\")\n\n# Model 2: Fine-tuned XGBoost\nprint(\"🟡 Training XGBoost (Extreme Tuning)...\")\nmodel_xgb = XGBClassifier(\n    n_estimators=1500,\n    max_depth=5,\n    learning_rate=0.01,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    colsample_bylevel=0.8,\n    gamma=2,\n    min_child_weight=5,\n    reg_alpha=0.5,\n    reg_lambda=1.0,\n    random_state=42,\n    tree_method='hist',\n    n_jobs=-1,\n    eval_metric='mlogloss'\n)\nmodel_xgb.fit(X_train, y_train)\nprint(\"   ✅ XGBoost trained\")\n\n# Model 3: Fine-tuned Gradient Boosting\nprint(\"🟠 Training Gradient Boosting (Extreme Tuning)...\")\nmodel_gb = GradientBoostingClassifier(\n    n_estimators=1000,\n    learning_rate=0.01,\n    max_depth=5,\n    min_samples_split=8,\n    min_samples_leaf=5,\n    subsample=0.8,\n    max_features='sqrt',\n    validation_fraction=0.15,\n    n_iter_no_change=50,\n    random_state=42\n)\nmodel_gb.fit(X_train, y_train)\nprint(\"   ✅ Gradient Boosting trained\")\n\n# =======================\n# ENSEMBLE PREDICTIONS\n# =======================\nprint(\"\\n🗳️  Creating Ensemble Predictions...\")\n\n# Hard Voting (Majority Vote)\npred_test_cb = model_catboost.predict(X_test)\npred_test_xgb = model_xgb.predict(X_test)\npred_test_gb = model_gb.predict(X_test)\n\n# Stack predictions and find mode\ny_test_hard = mode(np.column_stack([pred_test_cb, pred_test_xgb, pred_test_gb]), axis=1, keepdims=False)[0]\n\n# Soft Voting (Weighted Average of Probabilities)\ntest_prob_cb = model_catboost.predict_proba(X_test)\ntest_prob_xgb = model_xgb.predict_proba(X_test)\ntest_prob_gb = model_gb.predict_proba(X_test)\n\nweights = [3, 2, 2]  # CatBoost gets highest weight\nweights_norm = [w / sum(weights) for w in weights]\n\ny_test_soft = np.argmax(\n    weights_norm[0] * test_prob_cb + weights_norm[1] * test_prob_xgb + weights_norm[2] * test_prob_gb,\n    axis=1\n)\n\n# =======================\n# EVALUATION\n# =======================\nprint(\"\\n\" + \"=\"*70)\nprint(\"📊 MODEL PERFORMANCE COMPARISON\")\nprint(\"=\"*70)\n\nresults = []\n\n# Individual models\nfor name, model in [\n    (\"CatBoost\", model_catboost),\n    (\"XGBoost\", model_xgb),\n    (\"Gradient Boosting\", model_gb)\n]:\n    y_train_pred = model.predict(X_train)\n    y_test_pred = model.predict(X_test)\n    train_acc = accuracy_score(y_train, y_train_pred)\n    test_acc = accuracy_score(y_test, y_test_pred)\n    gap = abs(train_acc - test_acc)\n    results.append((name, train_acc, test_acc, gap))\n\n# Hard Voting\ntest_acc_hard = accuracy_score(y_test, y_test_hard)\nresults.append((\"Hard Voting\", None, test_acc_hard, None))\n\n# Soft Voting\ntest_acc_soft = accuracy_score(y_test, y_test_soft)\nresults.append((\"Soft Voting (3-2-2)\", None, test_acc_soft, None))\n\n# Print results\nfor name, train_acc, test_acc, gap in results:\n    symbol = \"🚀\" if test_acc >= 0.90 else \"📈\" if test_acc >= 0.85 else \"✅\"\n    if train_acc is not None:\n        print(f\"\\n{symbol} {name:25}\")\n        print(f\"   Train: {train_acc:.4f} ({train_acc*100:.2f}%)\")\n        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n        print(f\"   Gap:   {gap:.4f}\")\n    else:\n        print(f\"\\n{symbol} {name:25}\")\n        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n\n# Find best model\nbest_result = max([r for r in results if r[2] is not None], key=lambda x: x[2])\nbest_name, best_train, best_test, best_gap = best_result\n\nprint(\"\\n\" + \"=\"*70)\nprint(f\"🏆 BEST MODEL: {best_name}\")\nprint(f\"✅ Test Accuracy: {best_test:.4f} ({best_test*100:.2f}%)\")\nif best_test >= 0.90:\n    print(\"🎉 TARGET ACHIEVED: 90%+!\")\nelse:\n    print(f\"📈 Gap to 90%: {(0.90 - best_test)*100:.2f}%\")\nprint(\"=\"*70)\n\n# Use best ensemble method\nif test_acc_hard >= test_acc_soft:\n    y_test_pred_final = y_test_hard\n    print(\"🏅 Using Hard Voting Ensemble\")\nelse:\n    y_test_pred_final = y_test_soft\n    print(\"🏅 Using Soft Voting Ensemble\")\n\n# =======================\n# DETAILED REPORT\n# =======================\nle_target = LabelEncoder().fit(df_train['disease'])\ny_test_labels = le_target.inverse_transform(y_test)\ny_pred_labels = le_target.inverse_transform(y_test_pred_final)\n\nprint(\"\\n📋 CLASSIFICATION REPORT\")\nprint(\"=\"*70)\nprint(classification_report(y_test_labels, y_pred_labels))\n\n# =======================\n# CONFUSION MATRIX\n# =======================\ncm = confusion_matrix(y_test_labels, y_pred_labels)\n\nplt.figure(figsize=(10, 8))\nsns.heatmap(\n    cm, annot=True, fmt='d', cmap='RdYlGn',\n    xticklabels=le_target.classes_,\n    yticklabels=le_target.classes_,\n    cbar_kws={'label': 'Count'}\n)\nplt.xlabel(\"Predicted Label\", fontsize=12)\nplt.ylabel(\"True Label\", fontsize=12)\nplt.title(f\"Confusion Matrix - Ensemble Model\\nAccuracy: {max(test_acc_hard, test_acc_soft):.2%}\", fontsize=14, fontweight='bold')\nplt.tight_layout()\nplt.show()\n\nprint(\"\\n✅ TRAINING COMPLETE!\")\nprint(\"\\n\" + \"=\"*60)\nprint(\"🎯 AUDIO FEATURE USAGE SUMMARY:\")\nprint(\"=\"*60)\nif 'extraction_success' in train_audio.columns:\n    success_count = train_audio['extraction_success'].sum()\n    total_count = len(train_audio)\n    print(f\"✅ ORIGINAL FEATURES USED: {success_count}/{total_count} ({success_count/total_count*100:.1f}%)\")\n    print(f\"⚠️  DUMMY FEATURES USED: {total_count-success_count}/{total_count} ({(total_count-success_count)/total_count*100:.1f}%)\")\nelse:\n    print(\"ℹ️  Audio feature extraction status not tracked in cache\")\nprint(\"=\"*60)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ==========================================================\n# 🎯 SIMPLE & EFFECTIVE: Back to Basics + Micro-Tuning\n# Best previous: 86.36% - Let's push to 90%\n# ==========================================================\n\nimport os\nimport numpy as np\nimport pandas as pd\nimport librosa\nimport scipy\nimport pickle\nfrom tqdm import tqdm\nimport warnings\nwarnings.filterwarnings(\"ignore\")\n\nfrom sklearn.preprocessing import LabelEncoder, StandardScaler\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import accuracy_score, classification_report, confusion_matrix\nfrom sklearn.feature_selection import SelectKBest, f_classif\nfrom catboost import CatBoostClassifier\nimport seaborn as sns\nimport matplotlib.pyplot as plt\n\n# =======================\n# PATHS & PARAMETERS\n# =======================\nSOUND_DIR = \"/kaggle/input/airs-ai-in-respiratory-sounds/sounds/sounds/\"\nTRAIN_PATH = \"/kaggle/input/airs-ai-in-respiratory-sounds/train.csv\"\nTEST_PATH  = \"/kaggle/input/airs-ai-in-respiratory-sounds/test.csv\"\nCACHE_FILE = \"/kaggle/working/audio_cache_enhanced.pkl\"\n\nSR = 16000\nDURATION = 2\nTARGET_LEN = SR * DURATION\nN_MFCC = 30\n\n# =======================\n# LOAD DATA\n# =======================\nprint(\"📂 Loading data...\")\ndf_train = pd.read_csv(TRAIN_PATH)\ndf_test  = pd.read_csv(TEST_PATH)\n\nfor col in df_train.columns:\n    if df_train[col].isnull().sum() > 0:\n        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n\nfor col in df_test.columns:\n    if df_test[col].isnull().sum() > 0:\n        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n\n# =======================\n# ENHANCED AUDIO FEATURE EXTRACTION\n# =======================\ndef resample(y, orig_sr, target_sr=16000):\n    if orig_sr != target_sr:\n        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n    return y\n\ndef pad_truncate(y, length):\n    return np.pad(y, (0, max(0, length - len(y))))[:length]\n\ndef extract_audio(path):\n    try:\n        y, sr = librosa.load(path, sr=None)\n        y = resample(y, sr, SR)\n        y = pad_truncate(y, TARGET_LEN)\n\n        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n        delta = librosa.feature.delta(mfcc)\n        delta2 = librosa.feature.delta(mfcc, order=2)\n        \n        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n        \n        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n        \n        zcr = librosa.feature.zero_crossing_rate(y)\n        \n        spec_cent = librosa.feature.spectral_centroid(y=y, sr=SR)\n        spec_rolloff = librosa.feature.spectral_rolloff(y=y, sr=SR)\n        spec_bw = librosa.feature.spectral_bandwidth(y=y, sr=SR)\n        \n        rmse = librosa.feature.rms(y=y)\n\n        feats = np.concatenate([\n            mfcc.mean(1), mfcc.std(1),\n            delta.mean(1), delta.std(1),\n            delta2.mean(1), delta2.std(1),\n            chroma.mean(1), chroma.std(1),\n            contrast.mean(1), contrast.std(1),\n            tonnetz.mean(1),\n            mel.mean(1), mel.std(1),\n            [np.mean(tempogram)],\n            zcr.mean(1), zcr.std(1),\n            spec_cent.mean(1), spec_cent.std(1),\n            spec_rolloff.mean(1), spec_rolloff.std(1),\n            spec_bw.mean(1), spec_bw.std(1),\n            rmse.mean(1), rmse.std(1)\n        ])\n        return feats\n    except Exception as e:\n        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2)\n\ndef build_audio(df, cache=None):\n    if cache and os.path.exists(cache):\n        print(f\"📦 Loading cached features from {cache}...\")\n        with open(cache, \"rb\") as f:\n            return pickle.load(f)\n\n    print(\"🎵 Extracting ENHANCED audio features...\")\n    feats = [\n        extract_audio(os.path.join(SOUND_DIR, f\"{cid}.wav\"))\n        for cid in tqdm(df[\"candidateID\"])\n    ]\n\n    audio_df = pd.DataFrame(feats)\n    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n\n    if cache:\n        with open(cache, \"wb\") as f:\n            pickle.dump(audio_df, f)\n\n    return audio_df\n\ntrain_audio = build_audio(df_train, CACHE_FILE)\n\n# =======================\n# LABEL ENCODING\n# =======================\ncategorical_cols = [\n    'gender','tbContactHistory','wheezingHistory',\n    'phlegmCough','familyAsthmaHistory',\n    'feverHistory','coldPresent'\n]\n\ndf_train_enc = df_train.copy()\nfor col in categorical_cols:\n    le = LabelEncoder()\n    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n\n# =======================\n# MERGE FEATURES\n# =======================\nX = pd.concat([\n    df_train_enc.drop(['candidateID','disease'], axis=1),\n    train_audio.drop(['candidateID'], axis=1)\n], axis=1)\n\ny = LabelEncoder().fit_transform(df_train['disease'])\n\n# =======================\n# IMPUTE & SCALE\n# =======================\nX_values = X.values\nimputer = SimpleImputer(strategy=\"most_frequent\")\nX_imputed = imputer.fit_transform(X_values)\n\nscaler = StandardScaler()\nX = scaler.fit_transform(X_imputed)\n\n# =======================\n# FEATURE SELECTION (Keep original 500 or try optimal k)\n# =======================\nprint(\"\\n🔍 Testing different feature selection thresholds...\")\n\nfeature_thresholds = [350, 380, 400, 450, 500]  # More features = less aggressive filtering\nbest_feature_k = None\nbest_feature_acc = 0\n\nfor k in feature_thresholds:\n    if k > X.shape[1]:\n        k = X.shape[1]\n    \n    selector = SelectKBest(f_classif, k=k)\n    X_selected = selector.fit_transform(X, y)\n    \n    X_train, X_test, y_train, y_test = train_test_split(\n        X_selected, y, test_size=0.20, stratify=y, random_state=42\n    )\n    \n    # Quick test with simple CatBoost\n    model_test = CatBoostClassifier(\n        iterations=1500,\n        learning_rate=0.008,\n        depth=4,\n        l2_leaf_reg=40,\n        subsample=0.75,\n        bootstrap_type='Bernoulli',\n        verbose=0,\n        random_seed=42\n    )\n    model_test.fit(X_train, y_train, eval_set=(X_test, y_test))\n    \n    test_acc = accuracy_score(y_test, model_test.predict(X_test))\n    \n    if test_acc > best_feature_acc:\n        best_feature_acc = test_acc\n        best_feature_k = k\n    \n    print(f\"  k={k:3d}: Test Acc = {test_acc:.4f}\")\n\nprint(f\"\\n✅ Best feature threshold: k={best_feature_k} (accuracy: {best_feature_acc:.4f})\")\n\n# Use best feature count\nselector = SelectKBest(f_classif, k=best_feature_k)\nX = selector.fit_transform(X, y)\nprint(f\"✅ Final features: 500 → {best_feature_k}\")\n\n# =======================\n# TRAIN-TEST SPLIT\n# =======================\nX_train, X_test, y_train, y_test = train_test_split(\n    X, y, test_size=0.20, stratify=y, random_state=42\n)\n\nprint(f\"\\n✅ Train Samples: {X_train.shape[0]}\")\nprint(f\"✅ Test Samples : {X_test.shape[0]}\")\n\n# =======================\n# TEST MULTIPLE CATBOOST CONFIGS (Simple tuning)\n# =======================\nprint(\"\\n\" + \"=\"*70)\nprint(\"🎯 TESTING CATBOOST MICRO-CONFIGURATIONS\")\nprint(\"=\"*70)\n\nconfigs = [\n    # Based on what worked (86.36%)\n    {\n        'iterations': 3000,\n        'learning_rate': 0.005,\n        'depth': 5,\n        'l2_leaf_reg': 50,\n        'subsample': 0.7,\n        'name': 'Baseline (Original 86.36%)'\n    },\n    # Slight learning rate increase\n    {\n        'iterations': 2500,\n        'learning_rate': 0.007,\n        'depth': 5,\n        'l2_leaf_reg': 50,\n        'subsample': 0.7,\n        'name': 'Faster LR (lr=0.007)'\n    },\n    # More subsample\n    {\n        'iterations': 3000,\n        'learning_rate': 0.005,\n        'depth': 5,\n        'l2_leaf_reg': 50,\n        'subsample': 0.75,\n        'name': 'More Subsample (0.75)'\n    },\n    # Less regularization\n    {\n        'iterations': 3000,\n        'learning_rate': 0.005,\n        'depth': 5,\n        'l2_leaf_reg': 35,\n        'subsample': 0.7,\n        'name': 'Less Reg (l2=35)'\n    },\n    # Different depth\n    {\n        'iterations': 3000,\n        'learning_rate': 0.005,\n        'depth': 4,\n        'l2_leaf_reg': 50,\n        'subsample': 0.7,\n        'name': 'Simpler (depth=4)'\n    },\n]\n\nresults = []\n\nfor config in configs:\n    name = config.pop('name')\n    \n    model = CatBoostClassifier(\n        **config,\n        bootstrap_type='Bernoulli',\n        eval_metric='MultiClass',\n        random_seed=42,\n        verbose=0,\n        border_count=256,\n        colsample_bylevel=0.7,\n        min_data_in_leaf=15,\n        grow_policy='Lossguide'\n    )\n    \n    model.fit(X_train, y_train, eval_set=(X_test, y_test))\n    \n    y_train_pred = model.predict(X_train)\n    y_test_pred = model.predict(X_test)\n    train_acc = accuracy_score(y_train, y_train_pred)\n    test_acc = accuracy_score(y_test, y_test_pred)\n    gap = abs(train_acc - test_acc)\n    \n    results.append((name, model, train_acc, test_acc, gap))\n    \n    symbol = \"🚀\" if test_acc >= 0.90 else \"📈\" if test_acc >= 0.86 else \"⚠️\"\n    print(f\"\\n{symbol} {name}\")\n    print(f\"   Train: {train_acc:.4f} | Test: {test_acc:.4f} | Gap: {gap:.4f}\")\n\n# Find best\nbest_name, best_model, best_train, best_test, best_gap = max(results, key=lambda x: x[3])\n\nprint(\"\\n\" + \"=\"*70)\nprint(f\"🏆 BEST CONFIG: {best_name}\")\nprint(f\"✅ Test Accuracy: {best_test:.4f} ({best_test*100:.2f}%)\")\nif best_test >= 0.90:\n    print(\"🎉 🎉 🎉 TARGET ACHIEVED: 90%+! 🎉 🎉 🎉\")\nelse:\n    gap_to_90 = (0.90 - best_test) * 100\n    print(f\"📈 Gap to 90%: {gap_to_90:.2f}%\")\nprint(\"=\"*70)\n\n# =======================\n# FINAL REPORT\n# =======================\ny_test_pred_final = best_model.predict(X_test)\n\nle_target = LabelEncoder().fit(df_train['disease'])\ny_test_labels = le_target.inverse_transform(y_test)\ny_pred_labels = le_target.inverse_transform(y_test_pred_final)\n\nprint(\"\\n📋 CLASSIFICATION REPORT\")\nprint(\"=\"*70)\nprint(classification_report(y_test_labels, y_pred_labels))\n\n# =======================\n# CONFUSION MATRIX\n# =======================\ncm = confusion_matrix(y_test_labels, y_pred_labels)\n\nplt.figure(figsize=(10, 8))\nsns.heatmap(\n    cm, annot=True, fmt='d', cmap='RdYlGn',\n    xticklabels=le_target.classes_,\n    yticklabels=le_target.classes_,\n    cbar_kws={'label': 'Count'}\n)\nplt.xlabel(\"Predicted Label\", fontsize=12)\nplt.ylabel(\"True Label\", fontsize=12)\nplt.title(f\"Co
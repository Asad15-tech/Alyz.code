    "\n",
    "for col in df_train.columns:\n",
    "    if df_train[col].isnull().sum() > 0:\n",
    "        df_train[col].fillna(df_train[col].mode()[0], inplace=True)\n",
    "\n",
    "for col in df_test.columns:\n",
    "    if df_test[col].isnull().sum() > 0:\n",
    "        df_test[col].fillna(df_test[col].mode()[0], inplace=True)\n",
    "\n",
    "# =======================\n",
    "# ENHANCED AUDIO FEATURE EXTRACTION WITH TRACKING\n",
    "# =======================\n",
    "def resample(y, orig_sr, target_sr=16000):\n",
    "    if orig_sr != target_sr:\n",
    "        y = scipy.signal.resample(y, int(len(y) * target_sr / orig_sr))\n",
    "    return y\n",
    "\n",
    "def pad_truncate(y, length):\n",
    "    return np.pad(y, (0, max(0, length - len(y))))[:length]\n",
    "\n",
    "def extract_audio(path):\n",
    "    \"\"\"Extract audio features and track if original or dummy features are used\"\"\"\n",
    "    try:\n",
    "        y, sr = librosa.load(path, sr=None)\n",
    "        \n",
    "        # Check if audio loaded successfully\n",
    "        if y is None or len(y) == 0:\n",
    "            print(f\"⚠️  AUDIO ERROR: Empty file - {os.path.basename(path)}\")\n",
    "            return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2), False\n",
    "        \n",
    "        y = resample(y, sr, SR)\n",
    "        y = pad_truncate(y, TARGET_LEN)\n",
    "\n",
    "        # MFCC & Deltas\n",
    "        mfcc = librosa.feature.mfcc(y=y, sr=SR, n_mfcc=N_MFCC)\n",
    "        delta = librosa.feature.delta(mfcc)\n",
    "        delta2 = librosa.feature.delta(mfcc, order=2)\n",
    "        \n",
    "        # Chroma & Contrast\n",
    "        chroma = librosa.feature.chroma_stft(y=y, sr=SR)\n",
    "        contrast = librosa.feature.spectral_contrast(y=y, sr=SR)\n",
    "        tonnetz = librosa.feature.tonnetz(y=y, sr=SR)\n",
    "        \n",
    "        # Mel & Tempogram\n",
    "        mel = librosa.feature.melspectrogram(y=y, sr=SR, n_mels=128)\n",
    "        tempogram = librosa.feature.tempogram(y=y, sr=SR)\n",
    "        \n",
    "        # Zero Crossing Rate\n",
    "        zcr = librosa.feature.zero_crossing_rate(y)\n",
    "        \n",
    "        # Spectral features\n",
    "        spec_cent = librosa.feature.spectral_centroid(y=y, sr=SR)\n",
    "        spec_rolloff = librosa.feature.spectral_rolloff(y=y, sr=SR)\n",
    "        spec_bw = librosa.feature.spectral_bandwidth(y=y, sr=SR)\n",
    "        \n",
    "        # RMSE Energy\n",
    "        rmse = librosa.feature.rms(y=y)\n",
    "\n",
    "        feats = np.concatenate([\n",
    "            mfcc.mean(1), mfcc.std(1),\n",
    "            delta.mean(1), delta.std(1),\n",
    "            delta2.mean(1), delta2.std(1),\n",
    "            chroma.mean(1), chroma.std(1),\n",
    "            contrast.mean(1), contrast.std(1),\n",
    "            tonnetz.mean(1),\n",
    "            mel.mean(1), mel.std(1),\n",
    "            [np.mean(tempogram)],\n",
    "            zcr.mean(1), zcr.std(1),\n",
    "            spec_cent.mean(1), spec_cent.std(1),\n",
    "            spec_rolloff.mean(1), spec_rolloff.std(1),\n",
    "            spec_bw.mean(1), spec_bw.std(1),\n",
    "            rmse.mean(1), rmse.std(1)\n",
    "        ])\n",
    "        print(f\"✅ ORIGINAL FEATURES: {os.path.basename(path)}\")\n",
    "        return feats, True\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ EXTRACTION ERROR: {os.path.basename(path)} - {str(e)[:50]}\")\n",
    "        return np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2), False\n",
    "\n",
    "def build_audio(df, cache=None):\n",
    "    \"\"\"Build audio features with tracking\"\"\"\n",
    "    \n",
    "    # Check if cache exists and load it\n",
    "    if cache and os.path.exists(cache):\n",
    "        try:\n",
    "            print(\"📦 Loading cached features from {cache}...\")\n",
    "            with open(cache, \"rb\") as f:\n",
    "                audio_df = pickle.load(f)\n",
    "            print(f\"✅ Loaded {len(audio_df)} cached audio feature rows\")\n",
    "            \n",
    "            # Check if cache has success tracking column\n",
    "            if 'extraction_success' not in audio_df.columns:\n",
    "                print(\"⚠️  Cache is in old format (no extraction tracking)\")\n",
    "                # Add success column assuming all were successful\n",
    "                audio_df['extraction_success'] = True\n",
    "                audio_df['original_features_used'] = True\n",
    "            return audio_df\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Cache loading error: {e}. Re-extracting features...\")\n",
    "    \n",
    "    print(\"\\n🎵 EXTRACTING ENHANCED AUDIO FEATURES FROM SCRATCH...\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    feats = []\n",
    "    success_list = []\n",
    "    total_files = len(df[\"candidateID\"])\n",
    "    success_count = 0\n",
    "    fail_count = 0\n",
    "    \n",
    "    for cid in tqdm(df[\"candidateID\"], desc=\"Processing audio files\"):\n",
    "        path = os.path.join(SOUND_DIR, f\"{cid}.wav\")\n",
    "        \n",
    "        # Check if file exists\n",
    "        if not os.path.exists(path):\n",
    "            print(f\"❌ FILE NOT FOUND: {cid}.wav - Using DUMMY features\")\n",
    "            feats.append(np.zeros(30*2 + 30*2 + 30*2 + 12*2 + 7*2 + 6 + 128*2 + 1 + 1*2 + 1*2 + 1*2 + 1*2 + 1*2))\n",
    "            success_list.append(False)\n",
    "            fail_count += 1\n",
    "            continue\n",
    "            \n",
    "        feat, success = extract_audio(path)\n",
    "        feats.append(feat)\n",
    "        success_list.append(success)\n",
    "        \n",
    "        if success:\n",
    "            success_count += 1\n",
    "        else:\n",
    "            fail_count += 1\n",
    "    \n",
    "    # Create audio dataframe\n",
    "    audio_df = pd.DataFrame(feats)\n",
    "    audio_df[\"candidateID\"] = df[\"candidateID\"].values\n",
    "    audio_df[\"extraction_success\"] = success_list\n",
    "    audio_df[\"original_features_used\"] = success_list\n",
    "    \n",
    "    # Print summary\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"📊 AUDIO FEATURE EXTRACTION SUMMARY\")\n",
    "    print(\"=\"*60)\n",
    "    print(f\"✅ TOTAL FILES PROCESSED: {total_files}\")\n",
    "    print(f\"🎯 ORIGINAL FEATURES USED: {success_count} ({success_count/total_files*100:.1f}%)\")\n",
    "    print(f\"⚠️  DUMMY FEATURES USED: {fail_count} ({fail_count/total_files*100:.1f}%)\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    if fail_count > 0:\n",
    "        failed_ids = df[\"candidateID\"][[not s for s in success_list]].tolist()\n",
    "        print(f\"📋 Files with dummy features (first 10): {failed_ids[:10]}{'...' if len(failed_ids) > 10 else ''}\")\n",
    "    \n",
    "    if cache:\n",
    "        print(f\"\\n💾 Caching features to {cache}...\")\n",
    "        with open(cache, \"wb\") as f:\n",
    "            pickle.dump(audio_df, f)\n",
    "        print(\"✅ Features cached successfully\")\n",
    "    \n",
    "    return audio_df\n",
    "\n",
    "print(\"\\n🎵 Extracting audio features...\")\n",
    "train_audio = build_audio(df_train, CACHE_FILE)\n",
    "\n",
    "# =======================\n",
    "# LABEL ENCODING\n",
    "# =======================\n",
    "print(\"\\n🔤 Encoding categorical variables...\")\n",
    "categorical_cols = [\n",
    "    'gender','tbContactHistory','wheezingHistory',\n",
    "    'phlegmCough','familyAsthmaHistory',\n",
    "    'feverHistory','coldPresent'\n",
    "]\n",
    "\n",
    "df_train_enc = df_train.copy()\n",
    "for col in categorical_cols:\n",
    "    le = LabelEncoder()\n",
    "    df_train_enc[col] = le.fit_transform(df_train_enc[col].astype(str))\n",
    "\n",
    "print(\"✅ Categorical encoding completed\")\n",
    "\n",
    "# =======================\n",
    "# MERGE FEATURES WITH AUDIO STATUS CHECK\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🔗 MERGING FEATURES WITH AUDIO STATUS\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Check audio feature status\n",
    "if 'extraction_success' in train_audio.columns:\n",
    "    success_rate = train_audio['extraction_success'].mean() * 100\n",
    "    print(f\"📊 AUDIO STATUS: {success_rate:.1f}% original features ({train_audio['extraction_success'].sum()}/{len(train_audio)})\")\n",
    "else:\n",
    "    print(\"⚠️  Audio extraction status not available in cache\")\n",
    "\n",
    "# Prepare columns to drop\n",
    "audio_columns_to_drop = ['candidateID']\n",
    "if 'extraction_success' in train_audio.columns:\n",
    "    audio_columns_to_drop.append('extraction_success')\n",
    "if 'original_features_used' in train_audio.columns:\n",
    "    audio_columns_to_drop.append('original_features_used')\n",
    "\n",
    "print(f\"📊 Tabular data shape: {df_train_enc.drop(['candidateID','disease'], axis=1).shape}\")\n",
    "print(f\"🎵 Audio data shape: {train_audio.drop(audio_columns_to_drop, axis=1).shape}\")\n",
    "\n",
    "# Merge features\n",
    "X = pd.concat([\n",
    "    df_train_enc.drop(['candidateID','disease'], axis=1),\n",
    "    train_audio.drop(audio_columns_to_drop, axis=1)\n",
    "], axis=1)\n",
    "\n",
    "y = LabelEncoder().fit_transform(df_train['disease'])\n",
    "\n",
    "print(f\"✅ Final feature matrix shape: {X.shape}\")\n",
    "\n",
    "# =======================\n",
    "# IMPUTE & SCALE\n",
    "# =======================\n",
    "print(\"\\n⚙️  Preprocessing features...\")\n",
    "X_values = X.values\n",
    "\n",
    "imputer = SimpleImputer(strategy=\"most_frequent\")\n",
    "X_imputed = imputer.fit_transform(X_values)\n",
    "\n",
    "scaler = StandardScaler()\n",
    "X = scaler.fit_transform(X_imputed)\n",
    "\n",
    "print(\"✅ Imputation and scaling completed\")\n",
    "\n",
    "# =======================\n",
    "# FEATURE SELECTION (Remove Noise)\n",
    "# =======================\n",
    "print(\"\\n🔍 Selecting best features...\")\n",
    "selector = SelectKBest(f_classif, k=250)  # Keep 250 best features\n",
    "X = selector.fit_transform(X, y)\n",
    "print(f\"✅ Reduced features: 500 → 250\")\n",
    "\n",
    "# =======================\n",
    "# TRAIN-TEST SPLIT\n",
    "# =======================\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, stratify=y, random_state=42\n",
    ")\n",
    "\n",
    "print(f\"\\n📊 DATA SPLIT:\")\n",
    "print(f\"✅ Train Samples: {X_train.shape[0]} ({X_train.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"✅ Test Samples : {X_test.shape[0]} ({X_test.shape[0]/len(X)*100:.1f}%)\")\n",
    "print(f\"✅ Features per sample: {X_train.shape[1]}\")\n",
    "\n",
    "# =======================\n",
    "# CLASS WEIGHTS (for imbalanced classes)\n",
    "# =======================\n",
    "print(\"\\n⚖️  Computing class weights for imbalance...\")\n",
    "weights = class_weight.compute_class_weight(\n",
    "    class_weight='balanced',\n",
    "    classes=np.unique(y_train),\n",
    "    y=y_train\n",
    ")\n",
    "class_weights_dict = {i: weights[i] for i in range(len(weights))}\n",
    "print(f\"📊 Class Weights: {class_weights_dict}\")\n",
    "\n",
    "# Class distribution\n",
    "unique, counts = np.unique(y_train, return_counts=True)\n",
    "for cls, cnt in zip(unique, counts):\n",
    "    print(f\"   Class {cls}: {cnt} samples ({cnt/len(y_train)*100:.1f}%)\")\n",
    "\n",
    "# =======================\n",
    "# TRAIN FINE-TUNED MODELS\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"🚀 TRAINING OPTIMIZED ENSEMBLE (WITH AUDIO TRACKING)\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "print(\"\\n📚 Training Base Learners...\\n\")\n",
    "\n",
    "# Model 1: Fine-tuned CatBoost\n",
    "print(\"🔵 Training CatBoost (Extreme Tuning)...\")\n",
    "model_catboost = CatBoostClassifier(\n",
    "    iterations=1500,\n",
    "    learning_rate=0.01,\n",
    "    depth=5,\n",
    "    l2_leaf_reg=30,\n",
    "    bootstrap_type='Bernoulli',\n",
    "    subsample=0.8,\n",
    "    eval_metric='MultiClass',\n",
    "    random_seed=42,\n",
    "    class_weights=class_weights_dict,\n",
    "    verbose=0,\n",
    "    border_count=128,\n",
    "    colsample_bylevel=0.8,\n",
    "    min_data_in_leaf=10,\n",
    "    grow_policy='Lossguide'\n",
    ")\n",
    "model_catboost.fit(X_train, y_train)\n",
    "print(\"   ✅ CatBoost trained\")\n",
    "\n",
    "# Model 2: Fine-tuned XGBoost\n",
    "print(\"🟡 Training XGBoost (Extreme Tuning)...\")\n",
    "model_xgb = XGBClassifier(\n",
    "    n_estimators=1500,\n",
    "    max_depth=5,\n",
    "    learning_rate=0.01,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    colsample_bylevel=0.8,\n",
    "    gamma=2,\n",
    "    min_child_weight=5,\n",
    "    reg_alpha=0.5,\n",
    "    reg_lambda=1.0,\n",
    "    random_state=42,\n",
    "    tree_method='hist',\n",
    "    n_jobs=-1,\n",
    "    eval_metric='mlogloss'\n",
    ")\n",
    "model_xgb.fit(X_train, y_train)\n",
    "print(\"   ✅ XGBoost trained\")\n",
    "\n",
    "# Model 3: Fine-tuned Gradient Boosting\n",
    "print(\"🟠 Training Gradient Boosting (Extreme Tuning)...\")\n",
    "model_gb = GradientBoostingClassifier(\n",
    "    n_estimators=1000,\n",
    "    learning_rate=0.01,\n",
    "    max_depth=5,\n",
    "    min_samples_split=8,\n",
    "    min_samples_leaf=5,\n",
    "    subsample=0.8,\n",
    "    max_features='sqrt',\n",
    "    validation_fraction=0.15,\n",
    "    n_iter_no_change=50,\n",
    "    random_state=42\n",
    ")\n",
    "model_gb.fit(X_train, y_train)\n",
    "print(\"   ✅ Gradient Boosting trained\")\n",
    "\n",
    "# =======================\n",
    "# ENSEMBLE PREDICTIONS\n",
    "# =======================\n",
    "print(\"\\n🗳️  Creating Ensemble Predictions...\")\n",
    "\n",
    "# Hard Voting (Majority Vote)\n",
    "pred_test_cb = model_catboost.predict(X_test)\n",
    "pred_test_xgb = model_xgb.predict(X_test)\n",
    "pred_test_gb = model_gb.predict(X_test)\n",
    "\n",
    "# Stack predictions and find mode\n",
    "y_test_hard = mode(np.column_stack([pred_test_cb, pred_test_xgb, pred_test_gb]), axis=1, keepdims=False)[0]\n",
    "\n",
    "# Soft Voting (Weighted Average of Probabilities)\n",
    "test_prob_cb = model_catboost.predict_proba(X_test)\n",
    "test_prob_xgb = model_xgb.predict_proba(X_test)\n",
    "test_prob_gb = model_gb.predict_proba(X_test)\n",
    "\n",
    "weights = [3, 2, 2]  # CatBoost gets highest weight\n",
    "weights_norm = [w / sum(weights) for w in weights]\n",
    "\n",
    "y_test_soft = np.argmax(\n",
    "    weights_norm[0] * test_prob_cb + weights_norm[1] * test_prob_xgb + weights_norm[2] * test_prob_gb,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# =======================\n",
    "# EVALUATION\n",
    "# =======================\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"📊 MODEL PERFORMANCE COMPARISON\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "results = []\n",
    "\n",
    "# Individual models\n",
    "for name, model in [\n",
    "    (\"CatBoost\", model_catboost),\n",
    "    (\"XGBoost\", model_xgb),\n",
    "    (\"Gradient Boosting\", model_gb)\n",
    "]:\n",
    "    y_train_pred = model.predict(X_train)\n",
    "    y_test_pred = model.predict(X_test)\n",
    "    train_acc = accuracy_score(y_train, y_train_pred)\n",
    "    test_acc = accuracy_score(y_test, y_test_pred)\n",
    "    gap = abs(train_acc - test_acc)\n",
    "    results.append((name, train_acc, test_acc, gap))\n",
    "\n",
    "# Hard Voting\n",
    "test_acc_hard = accuracy_score(y_test, y_test_hard)\n",
    "results.append((\"Hard Voting\", None, test_acc_hard, None))\n",
    "\n",
    "# Soft Voting\n",
    "test_acc_soft = accuracy_score(y_test, y_test_soft)\n",
    "results.append((\"Soft Voting (3-2-2)\", None, test_acc_soft, None))\n",
    "\n",
    "# Print results\n",
    "for name, train_acc, test_acc, gap in results:\n",
    "    symbol = \"🚀\" if test_acc >= 0.90 else \"📈\" if test_acc >= 0.85 else \"✅\"\n",
    "    if train_acc is not None:\n",
    "        print(f\"\\n{symbol} {name:25}\")\n",
    "        print(f\"   Train: {train_acc:.4f} ({train_acc*100:.2f}%)\")\n",
    "        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n",
    "        print(f\"   Gap:   {gap:.4f}\")\n",
    "    else:\n",
    "        print(f\"\\n{symbol} {name:25}\")\n",
    "        print(f\"   Test:  {test_acc:.4f} ({test_acc*100:.2f}%)\")\n",
    "\n",
    "# Find best model\n",
    "best_result = max([r for r in results if r[2] is not None], key=lambda x: x[2])\n",
    "best_name, best_train, best_test, best_gap = best_result\n",
    "\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(f\"🏆 BEST MODEL: {best_name}\")\n",
    "print(f\"✅ Test Accuracy: {best_test:.4f} ({best_test*100:.2f}%)\")\n",
    "if best_test >= 0.90:\n",
    "    print(\"🎉 TARGET ACHIEVED: 90%+!\")\n",
    "else:\n",
    "    print(f\"📈 Gap to 90%: {(0.90 - best_test)*100:.2f}%\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "# Use best ensemble method\n",
    "if test_acc_hard >= test_acc_soft:\n",
    "    y_test_pred_final = y_test_hard\n",
    "    print(\"🏅 Using Hard Voting Ensemble\")\n",
    "else:\n",
    "    y_test_pred_final = y_test_soft\n",
    "    print(\"🏅 Using Soft Voting Ensemble\")\n",
    "\n",
    "# =======================\n",
    "# DETAILED REPORT\n",
    "# =======================\n",
    "le_target = LabelEncoder().fit(df_train['disease'])\n",
    "y_test_labels = le_target.inverse_transform(y_test)\n",
    "y_pred_labels = le_target.inverse_transform(y_test_pred_final)\n",
    "\n",
    "print(\"\\n📋 CLASSIFICATION REPORT\")\n",
    "print(\"=\"*70)\n",
    "print(classification_report(y_test_labels, y_pred_labels))\n",
    "\n",
    "# =======================\n",
    "# CONFUSION MATRIX\n",
    "# =======================\n",
    "cm = confusion_matrix(y_test_labels, y_pred_labels)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(\n",
    "    cm, annot=True, fmt='d', cmap='RdYlGn',\n",
    "    xticklabels=le_target.classes_,\n",
    "    yticklabels=le_target.classes_,\n",
    "    cbar_kws={'label': 'Count'}\n",
    ")\n",
    "plt.xlabel(\"Predicted Label\", fontsize=12)\n",
    "plt.ylabel(\"True Label\", fontsize=12)\n",
    "plt.title(f\"Confusion Matrix - Ensemble Model\\nAccuracy: {max(test_acc_hard, test_acc_soft):.2%}\", fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\n✅ TRAINING COMPLETE!\")\n",
    "print(\"\\n\" + \"=\"*60)\n",
    "print(\"🎯 AUDIO FEATURE USAGE SUMMARY:\")\n",
    "print(\"=\"*60)\n",
    "if 'extraction_success' in train_audio.columns:\n",
    "    success_count = train_audio['extraction_success'].sum()\n",
    "    total_count = len(train_audio)\n",
    "    print(f\"✅ ORIGINAL FEATURES USED: {success_count}/{total_count} ({success_count/total_count*100:.1f}%)\")\n",
    "    print(f\"⚠️  DUMMY FEATURES USED: {total_count-success_count}/{total_count} ({(total_count-success_count)/total_count*100:.1f}%)\")\n",
